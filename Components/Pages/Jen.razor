    UploadedById="@(CurrentEngineerId == 0 ? null : CurrentEngineerId)"
    CanUpload="@(CurrentRole == "AEN" || CurrentRole == "XEN" || CurrentRole == "ADMIN")"
    CanDelete="@(CurrentRole == "AEN" || CurrentRole == "XEN" || CurrentRole == "ADMIN")"
    OnClose="CloseFilesModal"
    OnChanged="ReloadFileCountsAsync" />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // Auth state
    string CurrentRole         = "";
    int    CurrentEngineerId   = 0;
    string CurrentEngineerName = "";

    // Page state
    string SelectedFilter   = "ALL";
    string SelectedCategory = "";
    string SelectedYear     = "";
    string SearchText       = "";

    List<string> WorkYears => AllWorks
        .Select(w => !string.IsNullOrEmpty(w.FinancialYear) ? w.FinancialYear
                     : (w.StartDate.HasValue ? Work_Dashboard.Services.WorkHelpers.FinYear(w.StartDate.Value) : null))
        .Where(y => !string.IsNullOrEmpty(y))
        .Distinct()
        .OrderByDescending(y => y)
        .ToList()!;
    bool   IsLoading        = true;

    List<Work>   AllWorks      = [];
    List<Work>   FilteredWorks = [];
    List<string> CategoryCodes = [];

    Dictionary<int, WorkRemark> LatestRemarksMap = [];

    // Files modal
    Work? FilesModalWork = null;
    Dictionary<int, (int pdfs, int photos)> FileCounts = new();

    void OpenFilesModal(Work w) => FilesModalWork = w;
    void CloseFilesModal()      => FilesModalWork = null;

    async Task ReloadFileCountsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        FileCounts = await db.WorkFiles
            .GroupBy(f => f.WorkId)
            .Select(g => new
            {
                WorkId = g.Key,
                Pdfs   = g.Count(x => x.FileType == WorkFileType.pdf),
                Photos = g.Count(x => x.FileType == WorkFileType.image)
            })
            .ToDictionaryAsync(x => x.WorkId, x => (x.Pdfs, x.Photos));
    }

    // Work detail modal
    bool  ShowDetailModal = false;
    Work? DetailWork      = null;

    // Remarks (inline in detail modal)
    Work?            RemarksWork       = null;
    List<WorkRemark> RemarksList       = [];
    string           NewRemarkText     = "";
    string           RemarkError       = "";
    int              EditingRemarkId   = 0;
    string           EditingRemarkText = "";

    // Confirm delete work
    bool  ShowConfirmDeleteWork = false;
    Work? ConfirmDeleteWorkItem = null;

    // Inline expand
    HashSet<int> ExpandedWorkIds = new();
    void ToggleExpand(int workId) { if (!ExpandedWorkIds.Remove(workId)) ExpandedWorkIds.Add(workId); }

    // Hindi toggle for comment textarea
    bool HindiRemarkMode = false;

    // Edit Work modal (XEN only)
    bool   ShowEditWorkModal   = false;
    Work   EditingWork         = new();
    string EditWorkStatusStr   = "ONGOING";
    string EditWorkCategoryId  = "";
    string EditWorkFundSourceId = "";
    string EditWorkJenId       = "";
    string EditWorkAenId       = "";
    string EditWorkXenId       = "";
    string EditWorkError       = "";
    string EditMobileError     = "";

    // Add Work modal (XEN only)
    bool   ShowAddWorkModal    = false;
    Work   NewWork             = new();
    string NewWorkStatusStr    = "ONGOING";
    string NewWorkCategoryId   = "";
    string NewWorkFundSourceId = "";
    string NewWorkJenId        = "";
    string NewWorkAenId        = "";
    string NewWorkXenId        = "";
    string AddWorkError        = "";
    string AddMobileError      = "";

    // Form data for Add Work
    List<WorkCategory> FormCategories   = [];
    List<FundSource>   FormFundSources  = [];
    List<Engineer>     FormJenEngineers = [];
    List<Engineer>     FormAenEngineers = [];
    List<Engineer>     FormXenEngineers = [];

    // Password change modal
    bool   ShowPasswordModal = false;
    string PwdCurrent        = "";
    string PwdNew            = "";
    string PwdConfirm        = "";
    string PwdError          = "";
    string PwdSuccess        = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        IsLoading = false;
    }

    async Task LoadData()
    {
        var auth  = await AuthState!;
        var idStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        CurrentEngineerId   = idStr is not null && int.TryParse(idStr, out var pid) ? pid : 0;
        CurrentRole         = auth.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
        CurrentEngineerName = auth.User.Identity?.Name ?? "";

        await using var db = await DbFactory.CreateDbContextAsync();

        var q = db.Works
            .Where(w => !w.IsDeleted)
            .Include(w => w.AssignedJen)
            .Include(w => w.AssignedAen)
            .Include(w => w.AssignedExen)
            .Include(w => w.Category)
            .Include(w => w.FundSource)
            .OrderByDescending(w => w.CreatedAt);

        // Show only works assigned to this engineer based on their role
        AllWorks = CurrentRole switch
        {
            "JEN" => await q.Where(w => w.AssignedJenId  == CurrentEngineerId).ToListAsync(),
            "AEN" => await q.Where(w => w.AssignedAenId  == CurrentEngineerId).ToListAsync(),
            "XEN" => await q.Where(w => w.AssignedExenId == CurrentEngineerId).ToListAsync(),
            _     => await q.ToListAsync()
        };

        // Latest remark per work (only for loaded works)
        var workIds    = AllWorks.Select(w => w.WorkId).ToList();
        var allRemarks = await db.WorkRemarks
            .Where(r => workIds.Contains(r.WorkId))
            .OrderBy(r => r.CreatedAt)
            .ToListAsync();
        LatestRemarksMap = allRemarks
            .GroupBy(r => r.WorkId)
            .ToDictionary(g => g.Key, g => g.Last());

        await ReloadFileCountsAsync();

        CategoryCodes = AllWorks
            .Where(w => w.Category != null)
            .Select(w => w.Category!.CategoryCode)
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        // Load form data for AEN/XEN Add Work modal
        if (CurrentRole == "XEN" || CurrentRole == "AEN")
        {
            FormCategories   = await db.WorkCategories.Where(c => c.IsActive).OrderBy(c => c.CategoryCode).ToListAsync();
            FormFundSources  = await db.FundSources.Where(f => f.IsActive).OrderBy(f => f.SourceCode).ToListAsync();
            var allEng       = await db.Engineers.Where(e => !e.IsDeleted && e.IsActive).OrderBy(e => e.Name).ToListAsync();
            FormJenEngineers = allEng.Where(e => e.Role == EngineerRole.JEN).ToList();
            FormAenEngineers = allEng.Where(e => e.Role == EngineerRole.AEN).ToList();
            FormXenEngineers = allEng.Where(e => e.Role == EngineerRole.XEN).ToList();
        }

        ApplyFilter();
    }

    void ApplyFilter()
    {
        var q = AllWorks.AsEnumerable();

        q = SelectedFilter switch
        {
            "ONGOING"   => q.Where(w => w.Status == WorkStatus.ONGOING && !w.IsAnnualContract),
            "COMPLETED" => q.Where(w => w.Status == WorkStatus.COMPLETED),
            "ANNUAL"    => q.Where(w => w.IsAnnualContract),
            _           => q
        };

        if (!string.IsNullOrWhiteSpace(SelectedCategory))
            q = q.Where(w => w.Category?.CategoryCode == SelectedCategory);

        if (!string.IsNullOrWhiteSpace(SelectedYear))
            q = q.Where(w =>
                (!string.IsNullOrEmpty(w.FinancialYear) && w.FinancialYear == SelectedYear) ||
                (string.IsNullOrEmpty(w.FinancialYear) && w.StartDate.HasValue &&
                 Work_Dashboard.Services.WorkHelpers.FinYear(w.StartDate.Value) == SelectedYear));

        if (!string.IsNullOrWhiteSpace(SearchText))
            q = q.Where(w => w.WorkCode != null && w.WorkCode.Contains(SearchText, StringComparison.OrdinalIgnoreCase));

        FilteredWorks = q.ToList();
    }

    // ── Detail Modal ──────────────────────────────────────────
    async Task OpenDetail(Work w)
    {
        DetailWork    = w;
        RemarksWork   = w;
        NewRemarkText = "";
        RemarkError   = "";
        await using var db = await DbFactory.CreateDbContextAsync();
        RemarksList = await db.WorkRemarks
            .Where(r => r.WorkId == w.WorkId)
            .OrderBy(r => r.CreatedAt)
            .ToListAsync();
        ShowDetailModal = true;
    }

    void CloseDetail() { ShowDetailModal = false; DetailWork = null; RemarksWork = null; RemarksList = []; }

    // ── Remarks (inline in detail modal) ─────────────────────
    async Task AddRemark()
    {
        if (HindiRemarkMode)
            NewRemarkText = await JS.InvokeAsync<string>("bdaGetValue", "hindi-remark-jen");
        if (string.IsNullOrWhiteSpace(NewRemarkText))
        { RemarkError = "Remark cannot be empty."; return; }

        var auth        = await AuthState!;
        var authorName  = auth.User.Identity?.Name ?? "Unknown";
        var authorIdStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int? authorId   = authorIdStr is not null ? int.Parse(authorIdStr) : null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var remark = new WorkRemark
        {
            WorkId     = RemarksWork!.WorkId,
            Content    = NewRemarkText.Trim(),
            AuthorName = authorName,
            AuthorId   = authorId,
            CreatedAt  = DateTime.UtcNow
        };
        db.WorkRemarks.Add(remark);
        await db.SaveChangesAsync();

        LatestRemarksMap[RemarksWork.WorkId] = remark;
        NewRemarkText = "";
        RemarkError   = "";
        if (HindiRemarkMode)
            await JS.InvokeVoidAsync("eval", "var el=document.getElementById('hindi-remark-jen');if(el)el.value='';");
        RemarksList = await db.WorkRemarks
            .Where(r => r.WorkId == RemarksWork!.WorkId)
            .OrderBy(r => r.CreatedAt)
            .ToListAsync();
    }

    // ── Add Work (XEN) ────────────────────────────────────────
    async Task OpenEditWork(Work w)
    {
        EditingWork          = new Work
        {
            WorkId                  = w.WorkId,
            WorkName                = w.WorkName,
            WorkCode                = w.WorkCode,
            Department              = w.Department,
            ContractorName          = w.ContractorName,
            ContractorMobile        = w.ContractorMobile,
            SanctionedAmount        = w.SanctionedAmount,
            AnfNo                   = w.AnfNo,
            AnfDate                 = w.AnfDate,
            AgreementAmount         = w.AgreementAmount,
            WorkOrderNo             = w.WorkOrderNo,
            WorkOrderDate           = w.WorkOrderDate,
            ProgressPercent         = w.ProgressPercent,
            FinancialProgressPercent = w.FinancialProgressPercent,
            StartDate               = w.StartDate,
            ExpectedCompletion      = w.ExpectedCompletion,
            ActualStartDate         = w.ActualStartDate,
            ActualCompletion        = w.ActualCompletion,
            FinancialYear           = w.FinancialYear,
            IsAnnualContract        = w.IsAnnualContract,
            IsScheme                = w.IsScheme,
            IsCmBudget              = w.IsCmBudget,
            Status                  = w.Status,
        };
        EditWorkStatusStr    = w.Status.ToString();
        EditWorkCategoryId   = w.CategoryId?.ToString()   ?? "";
        EditWorkFundSourceId = w.FundSourceId?.ToString() ?? "";
        EditWorkJenId        = w.AssignedJenId?.ToString() ?? "";
        EditWorkAenId        = w.AssignedAenId?.ToString() ?? "";
        EditWorkXenId        = w.AssignedExenId?.ToString() ?? "";
        EditWorkError     = "";
        NewRemarkText     = "";
        RemarkError       = "";
        EditingRemarkId   = 0;
        EditingRemarkText = "";
        HindiRemarkMode   = false;
        RemarksWork       = w;

        await using var db = await DbFactory.CreateDbContextAsync();
        RemarksList = await db.WorkRemarks
            .Where(r => r.WorkId == w.WorkId)
            .OrderBy(r => r.CreatedAt)
            .ToListAsync();

        ShowEditWorkModal = true;
    }

    void CloseEditWorkModal()
    {
        ShowEditWorkModal = false;
        RemarksWork = null;
        RemarksList = [];
        NewRemarkText = "";
        RemarkError = "";
        EditingRemarkId = 0;
        EditingRemarkText = "";
        HindiRemarkMode = false;
        EditMobileError = "";
    }

    void ValidateEditMobile(string? val)
    {
        EditingWork.ContractorMobile = val;
        if (string.IsNullOrWhiteSpace(val)) { EditMobileError = ""; return; }
        val = val.Trim();
        if (!System.Text.RegularExpressions.Regex.IsMatch(val, @"^\d+$"))
            EditMobileError = "Only digits are allowed.";
        else if (val.Length != 10)
            EditMobileError = "Must be exactly 10 digits.";
        else
            EditMobileError = "";
    }


    bool _hindiAttachPending = false;

    void ToggleHindiMode(ChangeEventArgs e)
    {
        HindiRemarkMode = (bool)(e.Value ?? false);
        _hindiAttachPending = HindiRemarkMode; // attach after next render
        if (!HindiRemarkMode)
            _ = JS.InvokeVoidAsync("bdaHindi.detach", "hindi-remark-jen").AsTask();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_hindiAttachPending)
        {
            _hindiAttachPending = false;
            await JS.InvokeVoidAsync("bdaHindi.attach", "hindi-remark-jen");
        }
    }

    async Task SaveEditWork()
    {
        EditWorkError = "";
        if (string.IsNullOrWhiteSpace(EditingWork.WorkName))
        { EditWorkError = "Work name is required."; return; }
        if (!string.IsNullOrWhiteSpace(EditMobileError)) return;
        if (!string.IsNullOrWhiteSpace(EditingWork.ContractorMobile))
            EditingWork.ContractorMobile = EditingWork.ContractorMobile.Trim();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Duplicate work-order number check (exclude this work)
            if (!string.IsNullOrWhiteSpace(EditingWork.WorkCode))
            {
                var dup = await db.Works.AnyAsync(x =>
                    x.WorkCode == EditingWork.WorkCode.Trim() &&
                    !x.IsDeleted &&
                    x.WorkId != EditingWork.WorkId);
                if (dup) { EditWorkError = "Work Order Number already exists."; return; }
                EditingWork.WorkCode = EditingWork.WorkCode.Trim();
            }

            var w = await db.Works.FindAsync(EditingWork.WorkId);
            if (w is null) { EditWorkError = "Work not found."; return; }

            w.WorkName               = EditingWork.WorkName;
            w.WorkCode               = EditingWork.WorkCode;
            w.Department             = EditingWork.Department;
            w.ContractorName         = EditingWork.ContractorName;
            w.ContractorMobile       = EditingWork.ContractorMobile;
            w.SanctionedAmount       = EditingWork.SanctionedAmount;
            w.AnfNo                  = string.IsNullOrWhiteSpace(EditingWork.AnfNo) ? null : EditingWork.AnfNo.Trim();
            w.AnfDate                = EditingWork.AnfDate;
            w.AgreementAmount        = EditingWork.AgreementAmount;
            w.WorkOrderNo            = string.IsNullOrWhiteSpace(EditingWork.WorkOrderNo) ? null : EditingWork.WorkOrderNo.Trim();
            w.WorkOrderDate          = EditingWork.WorkOrderDate;
            w.ProgressPercent        = EditingWork.ProgressPercent;
            w.FinancialProgressPercent = EditingWork.FinancialProgressPercent;
            w.StartDate              = EditingWork.StartDate;
            w.ExpectedCompletion     = EditingWork.ExpectedCompletion;
            w.ActualStartDate        = EditingWork.ActualStartDate;
            w.ActualCompletion       = EditingWork.ActualCompletion;
            w.FinancialYear          = string.IsNullOrWhiteSpace(EditingWork.FinancialYear) ? null : EditingWork.FinancialYear.Trim();
            w.IsAnnualContract       = EditingWork.IsAnnualContract;
            w.IsScheme               = EditingWork.IsScheme;
            w.IsCmBudget             = EditingWork.IsCmBudget;
            w.Status                 = Enum.Parse<WorkStatus>(EditWorkStatusStr);
            w.UpdatedAt              = DateTime.UtcNow;

            if (int.TryParse(EditWorkCategoryId,   out var cid)) w.CategoryId    = cid; else w.CategoryId    = null;
            if (int.TryParse(EditWorkFundSourceId, out var fid)) w.FundSourceId  = fid; else w.FundSourceId  = null;
            if (int.TryParse(EditWorkJenId,        out var jid)) w.AssignedJenId = jid; else w.AssignedJenId = null;
            if (int.TryParse(EditWorkAenId,        out var aid)) w.AssignedAenId = aid; else w.AssignedAenId = null;
            if (int.TryParse(EditWorkXenId,        out var xid)) w.AssignedExenId = xid; else w.AssignedExenId = null;

            await db.SaveChangesAsync();
            await AuditSvc.LogAsync("works", w.WorkId, AuditAction.UPDATE, CurrentEngineerId,
                new { w.WorkName, w.Status });

            ShowEditWorkModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            EditWorkError = $"Error saving: {ex.Message}";
        }
    }

    void OpenAddWork()
    {
        NewWork            = new Work();
        NewWorkStatusStr   = "ONGOING";
        NewWorkCategoryId  = NewWorkFundSourceId = "";
        NewWorkJenId       = NewWorkAenId = NewWorkXenId = "";
        AddWorkError       = "";
        ShowAddWorkModal   = true;
    }

    void CloseAddWork() { ShowAddWorkModal = false; AddMobileError = ""; }

    void ValidateAddMobile(string? val)
    {
        NewWork.ContractorMobile = val;
        if (string.IsNullOrWhiteSpace(val)) { AddMobileError = ""; return; }
        val = val.Trim();
        if (!System.Text.RegularExpressions.Regex.IsMatch(val, @"^\d+$"))
            AddMobileError = "Only digits are allowed.";
        else if (val.Length != 10)
            AddMobileError = "Must be exactly 10 digits.";
        else
            AddMobileError = "";
    }

    async Task SaveNewWork()
    {
        AddWorkError = "";
        if (string.IsNullOrWhiteSpace(NewWork.WorkName))
        { AddWorkError = "Work name is required."; return; }
        if (!string.IsNullOrWhiteSpace(AddMobileError)) return;
        if (!string.IsNullOrWhiteSpace(NewWork.ContractorMobile))
            NewWork.ContractorMobile = NewWork.ContractorMobile.Trim();

        try
        {
            NewWork.Status    = Enum.Parse<WorkStatus>(NewWorkStatusStr);
            NewWork.CreatedAt = DateTime.UtcNow;

            if (!string.IsNullOrEmpty(NewWorkCategoryId)   && int.TryParse(NewWorkCategoryId,   out var cid)) NewWork.CategoryId    = cid;
            if (!string.IsNullOrEmpty(NewWorkFundSourceId) && int.TryParse(NewWorkFundSourceId, out var fid)) NewWork.FundSourceId  = fid;
            if (!string.IsNullOrEmpty(NewWorkJenId)        && int.TryParse(NewWorkJenId,        out var jid)) NewWork.AssignedJenId = jid;
            if (!string.IsNullOrEmpty(NewWorkAenId)        && int.TryParse(NewWorkAenId,        out var aid)) NewWork.AssignedAenId = aid;
            if (!string.IsNullOrEmpty(NewWorkXenId)        && int.TryParse(NewWorkXenId,        out var xid)) NewWork.AssignedExenId = xid;

            await using var db = await DbFactory.CreateDbContextAsync();

            // Duplicate work-order number check
            if (!string.IsNullOrWhiteSpace(NewWork.WorkCode))
            {
                var dup = await db.Works.AnyAsync(x =>
                    x.WorkCode == NewWork.WorkCode.Trim() && !x.IsDeleted);
                if (dup) { AddWorkError = "Work Order Number already exists."; return; }
                NewWork.WorkCode = NewWork.WorkCode.Trim();
            }
            db.Works.Add(NewWork);
            await db.SaveChangesAsync();
            await AuditSvc.LogAsync(
                "works", NewWork.WorkId, AuditAction.INSERT,
                CurrentEngineerId,
                new { NewWork.WorkName, NewWork.Status });

            ShowAddWorkModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            AddWorkError = $"Error saving work: {ex.Message}";
        }
    }

    async Task SaveEditRemark()
    {
        // Only Admin can modify existing comments
        if (CurrentRole != "ADMIN") return;
        if (EditingRemarkId == 0 || string.IsNullOrWhiteSpace(EditingRemarkText)) return;
        var auth       = await AuthState!;
        var editorName = auth.User.Identity?.Name ?? "Unknown";
        var idStr      = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int? editorId  = idStr is not null ? int.Parse(idStr) : null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var r = await db.WorkRemarks.FindAsync(EditingRemarkId);
        if (r is not null)
        {
            r.Content      = EditingRemarkText.Trim();
            r.EditedByName = editorName;
            r.EditedById   = editorId;
            r.EditedAt     = DateTime.UtcNow;
            await db.SaveChangesAsync();
            RemarksList = await db.WorkRemarks
                .Where(x => x.WorkId == r.WorkId)
                .OrderBy(x => x.CreatedAt)
                .ToListAsync();
            if (RemarksList.Any())
                LatestRemarksMap[r.WorkId] = RemarksList.Last();
        }
        EditingRemarkId = 0; EditingRemarkText = "";
    }

    async Task SoftDeleteWork()
    {
        if (ConfirmDeleteWorkItem is null) return;
        if (CurrentRole != "ADMIN") { ShowConfirmDeleteWork = false; ConfirmDeleteWorkItem = null; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var w = await db.Works.FindAsync(ConfirmDeleteWorkItem.WorkId);
        if (w is not null)
        {
            w.IsDeleted = true;
            await db.SaveChangesAsync();
            await AuditSvc.LogAsync("works", w.WorkId, AuditAction.DELETE, CurrentEngineerId,
                new { w.WorkName });
        }
        ShowConfirmDeleteWork = false; ConfirmDeleteWorkItem = null;
        await LoadData();
    }

    void ResetFilters()
    {
        SelectedFilter   = "ALL";
        SelectedCategory = "";
        SelectedYear     = "";
        SearchText       = "";
        ApplyFilter();
    }

    // ── Password Change ───────────────────────────────────────
    void OpenPasswordModal()
    {
        PwdCurrent = PwdNew = PwdConfirm = PwdError = PwdSuccess = "";
        ShowPasswordModal = true;
    }

    void ClosePasswordModal() => ShowPasswordModal = false;

    async Task ChangePassword()
    {
        PwdError = PwdSuccess = "";
        if (string.IsNullOrWhiteSpace(PwdCurrent) || string.IsNullOrWhiteSpace(PwdNew))
        { PwdError = "All fields are required."; return; }
        if (PwdNew != PwdConfirm)
        { PwdError = "New passwords do not match."; return; }
        if (PwdNew.Length < 6)
        { PwdError = "Password must be at least 6 characters."; return; }

        var auth  = await AuthState!;
        var idStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (idStr is null) { PwdError = "Session error. Please re-login."; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var eng = await db.Engineers.FindAsync(int.Parse(idStr));
        if (eng is null) { PwdError = "Account not found."; return; }
        if (!BCrypt.Net.BCrypt.Verify(PwdCurrent, eng.PasswordHash))
        { PwdError = "Current password is incorrect."; return; }

        eng.PasswordHash = BCrypt.Net.BCrypt.HashPassword(PwdNew);
        await db.SaveChangesAsync();
        PwdSuccess = "Password updated successfully.";
        PwdCurrent = PwdNew = PwdConfirm = "";
    }

    // ── Helpers — delegate to shared WorkHelpers ─────────────
    static string ProgColor(decimal pct)    => WorkHelpers.ProgColor(pct);
    static string StatusLabel(WorkStatus s) => WorkHelpers.StatusLabel(s);
}
