@page "/jen"
@attribute [Authorize(Roles = "JEN,ADMIN,AEN,XEN")]
@rendermode InteractiveServer
@inject IDbContextFactory<BdaDbContext> DbFactory
@inject NavigationManager Nav
@inject Work_Dashboard.Services.AuditService AuditSvc
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore
@using Work_Dashboard.Data
@using Work_Dashboard.Data.Entities
@using System.Security.Claims

<PageTitle>BDA Work Dashboard</PageTitle>

<div class="jen-shell">

    @* ── Sidebar ───────────────────────────────────────────────────── *@
    <aside class="jen-sidebar">
        <div class="sidebar-brand">
            <img src="/images/bda-logo.png" alt="BDA" class="sidebar-logo" />
            <div>
                <div class="sidebar-title">BDA</div>
                <div class="sidebar-subtitle">Work Dashboard</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <button class="nav-item active">
                <i class="bi bi-table"></i>
                <span>My Works</span>
            </button>
        </nav>

        <div class="sidebar-footer">
            <button class="btn-logout w-100 mb-2" @onclick="OpenPasswordModal">
                <i class="bi bi-key-fill"></i> Change Password
            </button>
            <form method="post" action="/account/logout">
                <button type="submit" class="btn-logout w-100">
                    <i class="bi bi-box-arrow-left"></i> Logout
                </button>
            </form>
        </div>
    </aside>

    @* ── Main Content ──────────────────────────────────────────────── *@
    <main class="jen-main">

        <div class="jen-topbar">
            <div class="topbar-brand">
                <img src="/images/bda-logo.png" alt="BDA" class="topbar-logo" />
                <div>
                    <h5 class="mb-0 fw-bold">My Assigned Works</h5>
                    <small class="text-muted">Bharatpur Development Authority</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="topbar-user">
                    <i class="bi bi-person-circle me-1"></i>
                    <AuthorizeView>
                        <span>@context.User.Identity?.Name</span>
                    </AuthorizeView>
                    @if (!string.IsNullOrEmpty(CurrentRole))
                    {
                        <span class="badge bg-secondary ms-1" style="font-size:0.65rem">@CurrentRole</span>
                    }
                </div>
            </div>
        </div>

        @if (IsLoading)
        {
            <div class="d-flex justify-content-center align-items-center" style="height:60vh">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            @* ── Works List ───────────────────────────────────── *@
            <div class="content-card">
                @* Filter Bar *@
                <div class="works-filter-bar">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="filter-group">
                            <span class="filter-group-label">Status</span>
                            <select class="filter-select-sm" @bind="SelectedFilter" @bind:after="ApplyFilter">
                                <option value="ALL">All</option>
                                <option value="ONGOING">Ongoing</option>
                                <option value="COMPLETED">Completed</option>
                                <option value="STALLED">Stalled</option>
                                <option value="ANNUAL">Annual</option>
                            </select>
                        </div>
                        <div class="filter-group">
                            <span class="filter-group-label">Category</span>
                            <select class="filter-select-sm" @bind="SelectedCategory" @bind:after="ApplyFilter">
                                <option value="">All</option>
                                @foreach (var cat in CategoryCodes)
                                { <option value="@cat">@cat</option> }
                            </select>
                        </div>
                        <div class="filter-group">
                            <span class="filter-group-label"><i class="bi bi-calendar-event me-1"></i>Year</span>
                            <select class="filter-select-sm" @bind="SelectedYear" @bind:after="ApplyFilter">
                                <option value="">All</option>
                                @foreach (var y in WorkYears)
                                { <option value="@y">@y</option> }
                            </select>
                        </div>
                        <div class="filter-search-wrap">
                            <i class="bi bi-search filter-search-icon"></i>
                            <input type="search" class="filter-search-input"
                                   placeholder="Search file no…"
                                   @bind="SearchText" @bind:after="ApplyFilter" />
                        </div>
                        <button class="btn-filter-reset" @onclick="ResetFilters">
                            <i class="bi bi-arrow-clockwise"></i> Reset
                        </button>
                        <div class="ms-auto d-flex align-items-center gap-2">
                            <div class="export-btn-group">
                                <button class="btn-export btn-export-csv" title="Download CSV" @onclick="ExportCsv">
                                    <i class="bi bi-filetype-csv"></i>
                                </button>
                                <button class="btn-export btn-export-xlsx" title="Download Excel" @onclick="ExportExcel">
                                    <i class="bi bi-file-earmark-excel-fill"></i>
                                </button>
                                <button class="btn-export btn-export-pdf" title="Download PDF" @onclick="ExportPdf">
                                    <i class="bi bi-file-earmark-pdf-fill"></i>
                                </button>
                            </div>
                            @if (CurrentRole == "XEN")
                            {
                                <button class="btn btn-sm btn-primary px-3" @onclick="OpenAddWork">
                                    <i class="bi bi-plus-lg me-1"></i>Add Work
                                </button>
                            }
                        </div>
                    </div>
                    <div class="mt-2">
                        <small class="text-muted">
                            Showing <strong>@FilteredWorks.Count</strong> of <strong>@AllWorks.Count</strong> works
                        </small>
                    </div>
                </div>

                @* Works Table *@
                <div class="table-responsive table-scroll-body">
                    <table class="table table-hover bda-table mb-0">
                        <thead class="thead-sticky">
                            <tr>
                                <th style="width:44px">#</th>
                                <th style="min-width:260px">Work Name / File No.</th>
                                <th style="min-width:110px">Status</th>
                                <th style="min-width:90px">Progress</th>
                                <th style="min-width:110px">JEN</th>
                                <th style="min-width:100px">AEN</th>
                                <th style="min-width:100px">XEN</th>
                                <th style="min-width:220px">Latest Remark</th>
                                <th style="min-width:120px">Files</th>
                                <th class="text-center" style="min-width:100px">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredWorks.Any())
                            {
                                <tr><td colspan="10" class="text-center text-muted py-5">No records found.</td></tr>
                            }
                            @{ int idx = 1; }
                            @foreach (var w in FilteredWorks)
                            {
                                var lr2 = LatestRemarksMap.GetValueOrDefault(w.WorkId);
                                var remarkText = lr2?.Content ?? (string.IsNullOrWhiteSpace(w.Remarks) ? null : w.Remarks);
                                bool isExpanded = ExpandedWorkIds.Contains(w.WorkId);
                                <tr class="@(isExpanded ? "work-row-expanded" : "")">
                                    <td class="text-muted fw-medium">@(idx++)</td>
                                    <td>
                                        <div class="d-flex align-items-start gap-1">
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="fw-semibold work-name-cell">@w.WorkName</div>
                                                <div class="d-flex align-items-center gap-1 mt-1">
                                                    @if (w.WorkCode != null)
                                                    {
                                                        <span class="work-fileno"><i class="bi bi-folder2 me-1"></i>@w.WorkCode</span>
                                                    }
                                                    @if (w.IsAnnualContract)
                                                    {
                                                        <span class="badge badge-annual">Annual</span>
                                                    }
                                                </div>
                                            </div>
                                            <button class="btn-expand-row" title="@(isExpanded ? "Collapse" : "Quick view")"
                                                    @onclick="() => ToggleExpand(w.WorkId)">
                                                <i class="bi bi-chevron-@(isExpanded ? "up" : "down")"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="status-pill status-pill-@w.Status.ToString().ToLower()">
                                            <span class="status-dot"></span>@StatusLabel(w.Status)
                                        </span>
                                    </td>
                                    <td>
                                        @if (w.ProgressPercent.HasValue)
                                        {
                                            <div class="mini-prog-wrap">
                                                <div class="mini-prog-bar">
                                                    <div class="mini-prog-fill @ProgColor(w.ProgressPercent.Value)"
                                                         style="width:@(w.ProgressPercent)%"></div>
                                                </div>
                                                <span class="mini-prog-label">@w.ProgressPercent%</span>
                                            </div>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td><span class="eng-name">@(w.AssignedJen?.Name ?? "—")</span></td>
                                    <td><span class="eng-name">@(w.AssignedAen?.Name ?? "—")</span></td>
                                    <td><span class="eng-name">@(w.AssignedExen?.Name ?? "—")</span></td>
                                    <td>
                                        @if (remarkText != null)
                                        {
                                            <div class="remark-preview">@remarkText</div>
                                            <button class="btn-read-more" @onclick="async () => await OpenDetail(w)">Read more</button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var pdfCount2   = FileCounts.GetValueOrDefault(w.WorkId).pdfs;
                                            var photoCount2 = FileCounts.GetValueOrDefault(w.WorkId).photos;
                                        }
                                        <span class="files-badge-cell" @onclick="() => OpenFilesModal(w)" title="Click to manage files">
                                            <span class="files-pill files-pill-pdf @(pdfCount2 == 0 ? "empty" : "")">
                                                <i class="bi bi-file-earmark-pdf-fill"></i>@pdfCount2
                                            </span>
                                            <span class="files-pill files-pill-img @(photoCount2 == 0 ? "empty" : photoCount2 >= 10 ? "full" : "")">
                                                <i class="bi bi-image-fill"></i>@photoCount2/10
                                            </span>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex gap-1 justify-content-center">
                                            <button class="action-btn action-btn-view" title="View Details"
                                                    @onclick="async () => await OpenDetail(w)">
                                                <i class="bi bi-eye-fill"></i>
                                            </button>
                                            @if (CurrentRole == "XEN")
                                            {
                                                <button class="action-btn action-btn-edit" title="Edit Work / Add Comment"
                                                        @onclick="async () => await OpenEditWork(w)">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                @if (isExpanded)
                                {
                                    <tr class="work-expand-row">
                                        <td colspan="10">
                                            <div class="work-expand-panel">
                                                <div class="expand-fullname">@w.WorkName</div>
                                                <div class="expand-grid">
                                                    <div class="expand-item">
                                                        <div class="expand-label">Physical Progress</div>
                                                        <div class="expand-val">
                                                            @if (w.ProgressPercent.HasValue)
                                                            {
                                                                <div class="progress-pill mb-1">
                                                                    <div class="progress-fill @ProgColor(w.ProgressPercent.Value)"
                                                                         style="width:@(w.ProgressPercent)%"></div>
                                                                </div>
                                                                <text>@w.ProgressPercent%</text>
                                                            }
                                                            else { <text>—</text> }
                                                        </div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Financial Progress</div>
                                                        <div class="expand-val">@(w.FinancialProgressPercent.HasValue ? $"{w.FinancialProgressPercent}%" : "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">A&amp;F Amount</div>
                                                        <div class="expand-val">@(w.SanctionedAmount.HasValue ? $"₹ {w.SanctionedAmount:N2} L" : "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">A&amp;F No.</div>
                                                        <div class="expand-val">@(w.AnfNo ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">A&amp;F Date</div>
                                                        <div class="expand-val">@(w.AnfDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Work Order Amount</div>
                                                        <div class="expand-val">@(w.AgreementAmount.HasValue ? $"₹ {w.AgreementAmount:N2} L" : "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Work Order No.</div>
                                                        <div class="expand-val">@(w.WorkOrderNo ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Work Order Date</div>
                                                        <div class="expand-val">@(w.WorkOrderDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Contractor</div>
                                                        <div class="expand-val">@(w.ContractorName ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Stipulated Start</div>
                                                        <div class="expand-val">@(w.StartDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Stipulated Completion</div>
                                                        <div class="expand-val">@(w.ExpectedCompletion?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Actual Start</div>
                                                        <div class="expand-val">@(w.ActualStartDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Actual Completion</div>
                                                        <div class="expand-val">@(w.ActualCompletion?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Financial Year</div>
                                                        <div class="expand-val">@(w.FinancialYear ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Category</div>
                                                        <div class="expand-val">@(w.Category?.CategoryName ?? w.Category?.CategoryCode ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Fund Source</div>
                                                        <div class="expand-val">@(w.FundSource?.SourceName ?? w.FundSource?.SourceCode ?? "—")</div>
                                                    </div>
                                                </div>
                                                @if (lr2 != null)
                                                {
                                                    <div class="expand-remark">
                                                        <i class="bi bi-chat-left-text me-1 text-primary"></i>
                                                        <span class="text-muted" style="font-size:0.72rem">
                                                            @lr2.AuthorName · @lr2.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                                        </span>
                                                        <div class="expand-remark-text">@lr2.Content</div>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </main>
</div>

@* ══ WORK DETAIL MODAL ════════════════════════════════════════ *@
@if (ShowDetailModal && DetailWork != null)
{
    <div class="modal-overlay" @onclick="CloseDetail">
        <div class="modal-box" style="max-width:680px;max-height:90vh" @onclick:stopPropagation>
            <div class="modal-box-header">
                <div>
                    <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle me-1 text-primary"></i>Work Details</h6>
                    <small class="text-muted">@DetailWork.WorkName[..Math.Min(80, DetailWork.WorkName.Length)]</small>
                </div>
                <button class="btn-close" @onclick="CloseDetail"></button>
            </div>
            <div class="modal-box-body">

                <p class="detail-section-title">Basic Information</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Work Name</div>
                        <div class="detail-val">@DetailWork.WorkName</div>
                    </div>
                    <div>
                        <div class="detail-label">File No. / Work Code</div>
                        <div class="detail-val">@(DetailWork.WorkCode ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Category</div>
                        <div class="detail-val">@(DetailWork.Category?.CategoryName ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Fund Source</div>
                        <div class="detail-val">@(DetailWork.FundSource?.SourceName ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Department</div>
                        <div class="detail-val">@(DetailWork.Department ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Status</div>
                        <div class="detail-val">
                            <span class="status-pill status-pill-@DetailWork.Status.ToString().ToLower()">
                                <span class="status-dot"></span>@StatusLabel(DetailWork.Status)
                            </span>
                        </div>
                    </div>
                </div>

                <p class="detail-section-title">Engineers</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">JEN</div>
                        <div class="detail-val">@(DetailWork.AssignedJen?.Name ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">AEN</div>
                        <div class="detail-val">@(DetailWork.AssignedAen?.Name ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Executive Engineer (XEN)</div>
                        <div class="detail-val">@(DetailWork.AssignedExen?.Name ?? "—")</div>
                    </div>
                </div>

                <p class="detail-section-title">Financial</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">A&amp;F Amount (लाखों)</div>
                        <div class="detail-val">@(DetailWork.SanctionedAmount?.ToString("N2") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">A&amp;F No.</div>
                        <div class="detail-val">@(DetailWork.AnfNo ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">A&amp;F Date</div>
                        <div class="detail-val">@(DetailWork.AnfDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Work Order Amount (लाखों)</div>
                        <div class="detail-val">@(DetailWork.AgreementAmount?.ToString("N2") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Work Order No.</div>
                        <div class="detail-val">@(DetailWork.WorkOrderNo ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Work Order Date</div>
                        <div class="detail-val">@(DetailWork.WorkOrderDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Expenditure (लाखों)</div>
                        <div class="detail-val">@(DetailWork.Expenditure?.ToString("N2") ?? "—")</div>
                    </div>
                </div>

                <p class="detail-section-title">Progress &amp; Dates</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Stipulated Work Start Date</div>
                        <div class="detail-val">@(DetailWork.StartDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Stipulated Work Completion Date</div>
                        <div class="detail-val">@(DetailWork.ExpectedCompletion?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Actual Work Start Date</div>
                        <div class="detail-val">@(DetailWork.ActualStartDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Financial Year</div>
                        <div class="detail-val">@(DetailWork.FinancialYear ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Physical Progress</div>
                        <div class="detail-val">
                            @if (DetailWork.ProgressPercent.HasValue)
                            {
                                <div class="progress-pill mb-1">
                                    <div class="progress-fill @ProgColor(DetailWork.ProgressPercent.Value)"
                                         style="width:@(DetailWork.ProgressPercent)%"></div>
                                </div>
                                @($"{DetailWork.ProgressPercent}%")
                            }
                            else { <span>—</span> }
                        </div>
                    </div>
                    <div>
                        <div class="detail-label">Financial Progress</div>
                        <div class="detail-val">@(DetailWork.FinancialProgressPercent.HasValue ? $"{DetailWork.FinancialProgressPercent}%" : "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Actual Work Completion Date</div>
                        <div class="detail-val">@(DetailWork.ActualCompletion?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                </div>

                <p class="detail-section-title">Contractor</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Contractor Name</div>
                        <div class="detail-val">@(DetailWork.ContractorName ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Contractor Mobile</div>
                        <div class="detail-val">@(DetailWork.ContractorMobile ?? "—")</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(DetailWork.Remarks))
                {
                    <p class="detail-section-title">Original Remarks</p>
                    <div class="remark-static">
                        <div class="remark-content">@DetailWork.Remarks</div>
                    </div>
                }

                @* ── Remarks section (read-only) ─────────────────── *@
                <hr class="my-3" />
                <p class="detail-section-title"><i class="bi bi-chat-dots me-1"></i>Remarks</p>
                @if (RemarksList.Any())
                {
                    <div class="remarks-scroll mb-2">
                        @foreach (var r in RemarksList)
                        {
                            <div class="remark-entry">
                                <div class="remark-meta">
                                    <i class="bi bi-person-circle me-1"></i>@r.AuthorName
                                    <span class="ms-2 text-muted" style="font-size:0.72rem">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                                </div>
                                @if (r.EditedAt.HasValue)
                                {
                                    <div class="remark-edited-meta">
                                        <i class="bi bi-pencil-fill me-1"></i>Edited by @r.EditedByName · @r.EditedAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                    </div>
                                }
                                <div class="remark-content">@r.Content</div>
                            </div>
                        }
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(DetailWork.Remarks))
                {
                    <p class="text-muted" style="font-size:0.82rem"><i class="bi bi-info-circle me-1"></i>No remarks yet.</p>
                }
                @if (CurrentRole == "XEN")
                {
                    <p class="text-muted fst-italic" style="font-size:0.8rem">
                        <i class="bi bi-pencil me-1"></i>Use the <strong>Edit</strong> button to add a remark.
                    </p>
                }

                @* ── Running Bills / Payment History ─────────────── *@
                <hr class="my-3" />
                <Work_Dashboard.Components.Shared.WorkBillsPanel
                    WorkId="@DetailWork.WorkId"
                    AgreementAmount="@DetailWork.AgreementAmount"
                    SanctionedAmount="@DetailWork.SanctionedAmount"
                    CanEdit="@(CurrentRole == "ADMIN" || CurrentRole == "ACCOUNTANT")"
                    CurrentUserId="@(CurrentEngineerId == 0 ? null : (int?)CurrentEngineerId)"
                    CurrentUserName="@CurrentEngineerName" />

            </div>
            <div class="modal-box-footer">
                <button class="btn btn-secondary btn-sm" @onclick="CloseDetail">Close</button>
                @if (CurrentRole == "XEN")
                {
