@page "/jen"
@attribute [Authorize(Roles = "JEN,ADMIN,AEN,XEN")]
@rendermode InteractiveServer
@inject IDbContextFactory<BdaDbContext> DbFactory
@inject NavigationManager Nav
@inject Work_Dashboard.Services.AuditService AuditSvc
@using Microsoft.EntityFrameworkCore
@using Work_Dashboard.Data
@using Work_Dashboard.Data.Entities
@using System.Security.Claims

<PageTitle>BDA Work Dashboard</PageTitle>

<div class="jen-shell">

    @* ── Sidebar ───────────────────────────────────────────────────── *@
    <aside class="jen-sidebar">
        <div class="sidebar-brand">
            <img src="/images/bda-logo.png" alt="BDA" class="sidebar-logo" />
            <div>
                <div class="sidebar-title">BDA</div>
                <div class="sidebar-subtitle">Work Dashboard</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <button class="nav-item active">
                <i class="bi bi-table"></i>
                <span>My Works</span>
            </button>
        </nav>

        <div class="sidebar-footer">
            <button class="btn-logout w-100 mb-2" @onclick="OpenPasswordModal">
                <i class="bi bi-key-fill"></i> Change Password
            </button>
            <form method="post" action="/account/logout">
                <button type="submit" class="btn-logout w-100">
                    <i class="bi bi-box-arrow-left"></i> Logout
                </button>
            </form>
        </div>
    </aside>

    @* ── Main Content ──────────────────────────────────────────────── *@
    <main class="jen-main">

        <div class="jen-topbar">
            <div>
                <h5 class="mb-0 fw-bold">My Assigned Works</h5>
                <small class="text-muted">Bharatpur Development Authority</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (CurrentRole == "XEN" || CurrentRole == "AEN")
                {
                    <button class="btn btn-sm btn-primary px-3" @onclick="OpenAddWork">
                        <i class="bi bi-plus-lg me-1"></i>Add Work
                    </button>
                }
                <div class="topbar-user">
                    <i class="bi bi-person-circle me-1"></i>
                    <AuthorizeView>
                        <span>@context.User.Identity?.Name</span>
                    </AuthorizeView>
                    @if (!string.IsNullOrEmpty(CurrentRole))
                    {
                        <span class="badge bg-secondary ms-1" style="font-size:0.65rem">@CurrentRole</span>
                    }
                </div>
            </div>
        </div>

        @if (IsLoading)
        {
            <div class="d-flex justify-content-center align-items-center" style="height:60vh">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            @* ── Works List ───────────────────────────────────── *@
            <div class="content-card">
                @* Filter Bar *@
                <div class="filter-bar">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap mb-0">Status:</label>
                            <select class="form-select form-select-sm filter-select"
                                    @bind="SelectedFilter" @bind:after="ApplyFilter">
                                <option value="ALL">All Works</option>
                                <option value="ONGOING">Ongoing</option>
                                <option value="COMPLETED">Completed</option>
                                <option value="ANNUAL">Annual Contract</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap mb-0">Category:</label>
                            <select class="form-select form-select-sm filter-select"
                                    @bind="SelectedCategory" @bind:after="ApplyFilter">
                                <option value="">All Categories</option>
                                @foreach (var cat in CategoryCodes)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="ms-auto">
                            <input class="form-control form-control-sm"
                                   style="min-width:220px"
                                   placeholder="🔍 Search work name..."
                                   @bind="SearchText" @bind:after="ApplyFilter" />
                        </div>
                    </div>
                    <div class="mt-2">
                        <small class="text-muted">
                            Showing <strong>@FilteredWorks.Count</strong> of <strong>@AllWorks.Count</strong> assigned works
                        </small>
                    </div>
                </div>

                @* Works Table *@
                <div class="table-responsive">
                    <table class="table table-hover bda-table mb-0">
                        <thead>
                            <tr>
                                <th style="width:40px">#</th>
                                <th style="min-width:260px">Work Name</th>
                                <th style="min-width:90px">Status</th>
                                <th style="min-width:110px">JEN</th>
                                <th style="min-width:110px">AEN</th>
                                <th style="min-width:110px">XEN</th>
                                <th style="min-width:220px">Latest Remark</th>
                                <th style="width:80px" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredWorks.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">
                                        <i class="bi bi-inbox" style="font-size:2rem;opacity:0.3;display:block;margin-bottom:0.5rem"></i>
                                        No assigned works found.
                                    </td>
                                </tr>
                            }
                            @{ int idx = 1; }
                            @foreach (var w in FilteredWorks)
                            {
                                <tr>
                                    <td class="text-muted">@(idx++)</td>
                                    <td>
                                        <span class="work-name fw-semibold">@w.WorkName</span>
                                        @if (!string.IsNullOrWhiteSpace(w.WorkCode))
                                        {
                                            <br /><small class="text-muted">@w.WorkCode</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="status-pill status-pill-@w.Status.ToString().ToLower()">
                                            <span class="status-dot"></span>@StatusLabel(w.Status)
                                        </span>
                                    </td>
                                    <td><small>@(w.AssignedJen?.Name ?? "—")</small></td>
                                    <td><small>@(w.AssignedAen?.Name ?? "—")</small></td>
                                    <td><small>@(w.AssignedExen?.Name ?? "—")</small></td>
                                    <td>
                                        @if (LatestRemarksMap.TryGetValue(w.WorkId, out var lr))
                                        {
                                            <small class="remarks-cell d-block">@lr.Content</small>
                                            <small class="text-muted" style="font-size:0.7rem">
                                                — @lr.AuthorName, @lr.CreatedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")
                                            </small>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(w.Remarks))
                                        {
                                            <small class="remarks-cell d-block text-muted">@w.Remarks</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex gap-1 justify-content-center">
                                            <button class="action-btn action-btn-view" title="Work Details"
                                                    @onclick="() => OpenDetail(w)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="action-btn action-btn-chat" title="View / Add Remarks"
                                                    @onclick="() => OpenRemarks(w)">
                                                <i class="bi bi-chat-dots"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </main>
</div>

@* ══ WORK DETAIL MODAL ════════════════════════════════════════ *@
@if (ShowDetailModal && DetailWork != null)
{
    <div class="modal-overlay" @onclick="CloseDetail">
        <div class="modal-box" style="max-width:680px;max-height:90vh" @onclick:stopPropagation>
            <div class="modal-box-header">
                <div>
                    <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle me-1 text-primary"></i>Work Details</h6>
                    <small class="text-muted">@DetailWork.WorkName[..Math.Min(80, DetailWork.WorkName.Length)]</small>
                </div>
                <button class="btn-close" @onclick="CloseDetail"></button>
            </div>
            <div class="modal-box-body">

                <p class="detail-section-title">Basic Information</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Work Name</div>
                        <div class="detail-val">@DetailWork.WorkName</div>
                    </div>
                    <div>
                        <div class="detail-label">File No. / Work Code</div>
                        <div class="detail-val">@(DetailWork.WorkCode ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Category</div>
                        <div class="detail-val">@(DetailWork.Category?.CategoryName ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Fund Source</div>
                        <div class="detail-val">@(DetailWork.FundSource?.SourceName ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Department</div>
                        <div class="detail-val">@(DetailWork.Department ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Status</div>
                        <div class="detail-val">
                            <span class="status-pill status-pill-@DetailWork.Status.ToString().ToLower()">
                                <span class="status-dot"></span>@StatusLabel(DetailWork.Status)
                            </span>
                        </div>
                    </div>
                </div>

                <p class="detail-section-title">Engineers</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">JEN</div>
                        <div class="detail-val">@(DetailWork.AssignedJen?.Name ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">AEN</div>
                        <div class="detail-val">@(DetailWork.AssignedAen?.Name ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Executive Engineer (XEN)</div>
                        <div class="detail-val">@(DetailWork.AssignedExen?.Name ?? "—")</div>
                    </div>
                </div>

                <p class="detail-section-title">Financial</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Sanctioned Amount (लाखों)</div>
                        <div class="detail-val">@(DetailWork.SanctionedAmount?.ToString("N2") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Agreement Amount (लाखों)</div>
                        <div class="detail-val">@(DetailWork.AgreementAmount?.ToString("N2") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Expenditure (लाखों)</div>
                        <div class="detail-val">@(DetailWork.Expenditure?.ToString("N2") ?? "—")</div>
                    </div>
                </div>

                <p class="detail-section-title">Progress &amp; Dates</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Start Date</div>
                        <div class="detail-val">@(DetailWork.StartDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Expected Completion</div>
                        <div class="detail-val">@(DetailWork.ExpectedCompletion?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Physical Progress</div>
                        <div class="detail-val">
                            @if (DetailWork.ProgressPercent.HasValue)
                            {
                                <div class="progress-pill mb-1">
                                    <div class="progress-fill @ProgressColor(DetailWork.ProgressPercent.Value)"
                                         style="width:@(DetailWork.ProgressPercent)%"></div>
                                </div>
                                @($"{DetailWork.ProgressPercent}%")
                            }
                            else { <span>—</span> }
                        </div>
                    </div>
                    <div>
                        <div class="detail-label">Financial Progress</div>
                        <div class="detail-val">@(DetailWork.FinancialProgressPercent.HasValue ? $"{DetailWork.FinancialProgressPercent}%" : "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Actual Completion</div>
                        <div class="detail-val">@(DetailWork.ActualCompletion?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                </div>

                <p class="detail-section-title">Contractor</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Contractor Name</div>
                        <div class="detail-val">@(DetailWork.ContractorName ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Contractor Mobile</div>
                        <div class="detail-val">@(DetailWork.ContractorMobile ?? "—")</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(DetailWork.Remarks))
                {
                    <p class="detail-section-title">Original Remarks</p>
                    <div class="remark-static">
                        <div class="remark-content">@DetailWork.Remarks</div>
                    </div>
                }

            </div>
            <div class="modal-box-footer">
                <button class="btn btn-secondary btn-sm" @onclick="CloseDetail">Close</button>
                <button class="btn btn-outline-primary btn-sm" @onclick="async () => { var w = DetailWork!; CloseDetail(); await OpenRemarks(w); }">
                    <i class="bi bi-chat-dots me-1"></i>View Remarks
                </button>
            </div>
        </div>
    </div>
}

@* ══ REMARKS MODAL ════════════════════════════════════════════ *@
@if (ShowRemarksModal && RemarksWork != null)
{
    <div class="modal-overlay" @onclick="CloseRemarks">
        <div class="modal-box modal-box-lg" style="max-width:600px;max-height:85vh" @onclick:stopPropagation>
            <div class="modal-box-header">
                <div>
                    <h6 class="mb-0 fw-bold"><i class="bi bi-chat-dots me-1 text-primary"></i>Remarks</h6>
                    <small class="text-muted">@RemarksWork.WorkName[..Math.Min(70, RemarksWork.WorkName.Length)]</small>
                </div>
                <button class="btn-close" @onclick="CloseRemarks"></button>
            </div>
            <div class="modal-box-body" style="display:flex;flex-direction:column;gap:0.75rem">

                @if (!string.IsNullOrWhiteSpace(RemarksWork.Remarks))
                {
                    <div class="remark-static">
                        <div class="remark-meta">
                            <i class="bi bi-file-earmark-text me-1"></i>
                            <strong>Original Record</strong>
                            <span class="ms-auto text-muted" style="font-size:0.73rem">Imported from sheet</span>
                        </div>
                        <div class="remark-content">@RemarksWork.Remarks</div>
                    </div>
                }

                @if (RemarksList.Any())
                {
                    <div class="remarks-scroll">
                        @foreach (var r in RemarksList)
                        {
                            <div class="remark-entry">
                                <div class="remark-meta">
                                    <i class="bi bi-person-circle me-1 text-primary"></i>
                                    <strong>@r.AuthorName</strong>
                                    <span class="ms-auto text-muted" style="font-size:0.73rem">
                                        @r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>
                                <div class="remark-content">@r.Content</div>
                            </div>
                        }
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(RemarksWork.Remarks))
                {
                    <div class="text-center text-muted py-2">
                        <i class="bi bi-chat-dots" style="font-size:2rem;opacity:0.3"></i>
                        <p class="mt-1 mb-0">No remarks yet. Be the first to add one.</p>
                    </div>
                }

                <div class="remark-add-box">
                    <label class="fw-semibold mb-1 d-block" style="font-size:0.85rem">Add Remark</label>
                    @if (!string.IsNullOrEmpty(RemarkError))
                    { <div class="alert alert-danger py-1 mb-2" style="font-size:0.82rem">@RemarkError</div> }
                    <textarea class="form-control form-control-sm" rows="3"
                              placeholder="Type your remark here…"
                              @bind="NewRemarkText"></textarea>
                    <div class="d-flex justify-content-end mt-2">
                        <button class="btn btn-sm btn-primary" @onclick="AddRemark">
                            <i class="bi bi-send-fill me-1"></i>Add Remark
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

@* ══ ADD WORK MODAL (XEN only) ════════════════════════════════ *@
@if (ShowAddWorkModal && (CurrentRole == "XEN" || CurrentRole == "AEN"))
{
    <div class="modal-overlay" @onclick="CloseAddWork">
        <div class="modal-box modal-box-lg" style="max-width:760px;max-height:92vh" @onclick:stopPropagation>
            <div class="modal-box-header">
                <div>
                    <h6 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-1 text-primary"></i>Add New Work</h6>
                    <small class="text-muted">Fill in work details</small>
                </div>
                <button class="btn-close" @onclick="CloseAddWork"></button>
            </div>
            <div class="modal-box-body">
                @if (!string.IsNullOrEmpty(AddWorkError))
                { <div class="alert alert-danger py-2 mb-3">@AddWorkError</div> }
                <div class="row">
                    <div class="col-12 mb-3">
                        <label class="form-label fw-semibold">Work Name <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="2" @bind="NewWork.WorkName" placeholder="Enter full work name"></textarea>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">File No. / Work Code</label>
                        <input class="form-control" @bind="NewWork.WorkCode" placeholder="e.g. 118/2024-25" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Category</label>
                        <select class="form-select" @bind="NewWorkCategoryId">
                            <option value="">— Select —</option>
                            @foreach (var c in FormCategories) { <option value="@c.CategoryId">@c.CategoryCode — @c.CategoryName</option> }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Fund Source</label>
                        <select class="form-select" @bind="NewWorkFundSourceId">
                            <option value="">— Select —</option>
                            @foreach (var f in FormFundSources) { <option value="@f.FundSourceId">@f.SourceCode — @f.SourceName</option> }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Department</label>
                        <input class="form-control" @bind="NewWork.Department" placeholder="e.g. BDA, TOURISM" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">JEN</label>
                        <select class="form-select" @bind="NewWorkJenId">
                            <option value="">— Select —</option>
                            @foreach (var e in FormJenEngineers) { <option value="@e.EngineerId">@e.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">AEN</label>
                        <select class="form-select" @bind="NewWorkAenId">
                            <option value="">— Select —</option>
                            @foreach (var e in FormAenEngineers) { <option value="@e.EngineerId">@e.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">XEN</label>
                        <select class="form-select" @bind="NewWorkXenId">
                            <option value="">— Select —</option>
                            @foreach (var e in FormXenEngineers) { <option value="@e.EngineerId">@e.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Status</label>
                        <select class="form-select" @bind="NewWorkStatusStr">
                            <option value="ONGOING">ONGOING</option>
                            <option value="COMPLETED">COMPLETED</option>
                            <option value="STALLED">STALLED</option>
                            <option value="CANCELLED">CANCELLED</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Sanctioned Amount (लाखों)</label>
                        <input type="number" step="0.01" class="form-control" @bind="NewWork.SanctionedAmount" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Agreement Amount (लाखों)</label>
                        <input type="number" step="0.01" class="form-control" @bind="NewWork.AgreementAmount" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Contractor Name</label>
                        <input class="form-control" @bind="NewWork.ContractorName" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Contractor Mobile</label>
                        <input class="form-control" @bind="NewWork.ContractorMobile" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Start Date</label>
                        <input type="date" class="form-control" @bind="NewWork.StartDate" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Expected Completion</label>
                        <input type="date" class="form-control" @bind="NewWork.ExpectedCompletion" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Physical Progress %</label>
                        <input type="number" step="1" min="0" max="100" class="form-control" @bind="NewWork.ProgressPercent" />
                    </div>
                    <div class="col-12 mb-2">
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkAnnualXen" @bind="NewWork.IsAnnualContract" />
                                <label class="form-check-label" for="chkAnnualXen">Annual Contract</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkSchemeXen" @bind="NewWork.IsScheme" />
                                <label class="form-check-label" for="chkSchemeXen">Scheme (योजना)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkCmXen" @bind="NewWork.IsCmBudget" />
                                <label class="form-check-label" for="chkCmXen">CM Budget</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label fw-semibold">Remarks</label>
                        <textarea class="form-control" rows="2" @bind="NewWork.Remarks"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-secondary btn-sm" @onclick="CloseAddWork">Cancel</button>
                <button class="btn btn-primary btn-sm" @onclick="SaveNewWork">
                    <i class="bi bi-check2 me-1"></i>Save Work
                </button>
            </div>
        </div>
    </div>
}

@* ══ CHANGE PASSWORD MODAL ═════════════════════════════════════ *@
@if (ShowPasswordModal)
{
    <div class="modal-overlay" @onclick="ClosePasswordModal">
        <div class="modal-box" style="max-width:380px" @onclick:stopPropagation>
            <div class="modal-box-header">
                <h6 class="mb-0 fw-bold"><i class="bi bi-key-fill me-1"></i>Change Password</h6>
                <button class="btn-close" @onclick="ClosePasswordModal"></button>
            </div>
            <div class="modal-box-body">
                @if (!string.IsNullOrEmpty(PwdError))   { <div class="alert alert-danger py-2">@PwdError</div> }
                @if (!string.IsNullOrEmpty(PwdSuccess)) { <div class="alert alert-success py-2">@PwdSuccess</div> }
                <div class="mb-3">
                    <label class="form-label fw-semibold">Current Password</label>
                    <input type="password" class="form-control" @bind="PwdCurrent" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">New Password</label>
                    <input type="password" class="form-control" @bind="PwdNew" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Confirm New Password</label>
                    <input type="password" class="form-control" @bind="PwdConfirm" />
                </div>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-secondary btn-sm" @onclick="ClosePasswordModal">Close</button>
                <button class="btn btn-primary btn-sm" @onclick="ChangePassword">
                    <i class="bi bi-check2 me-1"></i>Update Password
                </button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // Auth state
    string CurrentRole       = "";
    int    CurrentEngineerId = 0;

    // Page state
    string SelectedFilter   = "ALL";
    string SelectedCategory = "";
    string SearchText       = "";
    bool   IsLoading        = true;

    List<Work>   AllWorks      = [];
    List<Work>   FilteredWorks = [];
    List<string> CategoryCodes = [];

    Dictionary<int, WorkRemark> LatestRemarksMap = [];

    // Work detail modal
    bool  ShowDetailModal = false;
    Work? DetailWork      = null;

    // Remarks modal
    bool             ShowRemarksModal = false;
    Work?            RemarksWork      = null;
    List<WorkRemark> RemarksList      = [];
    string           NewRemarkText    = "";
    string           RemarkError      = "";

    // Add Work modal (XEN only)
    bool   ShowAddWorkModal    = false;
    Work   NewWork             = new();
    string NewWorkStatusStr    = "ONGOING";
    string NewWorkCategoryId   = "";
    string NewWorkFundSourceId = "";
    string NewWorkJenId        = "";
    string NewWorkAenId        = "";
    string NewWorkXenId        = "";
    string AddWorkError        = "";

    // Form data for Add Work
    List<WorkCategory> FormCategories   = [];
    List<FundSource>   FormFundSources  = [];
    List<Engineer>     FormJenEngineers = [];
    List<Engineer>     FormAenEngineers = [];
    List<Engineer>     FormXenEngineers = [];

    // Password change modal
    bool   ShowPasswordModal = false;
    string PwdCurrent        = "";
    string PwdNew            = "";
    string PwdConfirm        = "";
    string PwdError          = "";
    string PwdSuccess        = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        IsLoading = false;
    }

    async Task LoadData()
    {
        var auth  = await AuthState!;
        var idStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        CurrentEngineerId = idStr is not null && int.TryParse(idStr, out var pid) ? pid : 0;
        CurrentRole = auth.User.FindFirst(ClaimTypes.Role)?.Value ?? "";

        await using var db = await DbFactory.CreateDbContextAsync();

        var q = db.Works
            .Where(w => !w.IsDeleted)
            .Include(w => w.AssignedJen)
            .Include(w => w.AssignedAen)
            .Include(w => w.AssignedExen)
            .Include(w => w.Category)
            .Include(w => w.FundSource)
            .OrderByDescending(w => w.CreatedAt);

        // Show only works assigned to this engineer based on their role
        AllWorks = CurrentRole switch
        {
            "JEN" => await q.Where(w => w.AssignedJenId  == CurrentEngineerId).ToListAsync(),
            "AEN" => await q.Where(w => w.AssignedAenId  == CurrentEngineerId).ToListAsync(),
            "XEN" => await q.Where(w => w.AssignedExenId == CurrentEngineerId).ToListAsync(),
            _     => await q.ToListAsync()
        };

        // Latest remark per work (only for loaded works)
        var workIds    = AllWorks.Select(w => w.WorkId).ToList();
        var allRemarks = await db.WorkRemarks
            .Where(r => workIds.Contains(r.WorkId))
            .OrderBy(r => r.CreatedAt)
            .ToListAsync();
        LatestRemarksMap = allRemarks
            .GroupBy(r => r.WorkId)
            .ToDictionary(g => g.Key, g => g.Last());

        CategoryCodes = AllWorks
            .Where(w => w.Category != null)
            .Select(w => w.Category!.CategoryCode)
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        // Load form data for AEN/XEN Add Work modal
        if (CurrentRole == "XEN" || CurrentRole == "AEN")
        {
            FormCategories   = await db.WorkCategories.Where(c => c.IsActive).OrderBy(c => c.CategoryCode).ToListAsync();
            FormFundSources  = await db.FundSources.Where(f => f.IsActive).OrderBy(f => f.SourceCode).ToListAsync();
            var allEng       = await db.Engineers.Where(e => !e.IsDeleted && e.IsActive).OrderBy(e => e.Name).ToListAsync();
            FormJenEngineers = allEng.Where(e => e.Role == EngineerRole.JEN).ToList();
            FormAenEngineers = allEng.Where(e => e.Role == EngineerRole.AEN).ToList();
            FormXenEngineers = allEng.Where(e => e.Role == EngineerRole.XEN).ToList();
        }

        ApplyFilter();
    }

    void ApplyFilter()
    {
        var q = AllWorks.AsEnumerable();

        q = SelectedFilter switch
        {
            "ONGOING"   => q.Where(w => w.Status == WorkStatus.ONGOING && !w.IsAnnualContract),
            "COMPLETED" => q.Where(w => w.Status == WorkStatus.COMPLETED),
            "ANNUAL"    => q.Where(w => w.IsAnnualContract),
            _           => q
        };

        if (!string.IsNullOrWhiteSpace(SelectedCategory))
            q = q.Where(w => w.Category?.CategoryCode == SelectedCategory);

        if (!string.IsNullOrWhiteSpace(SearchText))
            q = q.Where(w => w.WorkName.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
                           || (w.WorkCode ?? "").Contains(SearchText, StringComparison.OrdinalIgnoreCase));

        FilteredWorks = q.ToList();
    }

    // ── Detail Modal ──────────────────────────────────────────
    void OpenDetail(Work w) { DetailWork = w; ShowDetailModal = true; }
    void CloseDetail()      { ShowDetailModal = false; DetailWork = null; }

    // ── Remarks ───────────────────────────────────────────────
    async Task OpenRemarks(Work w)
    {
        RemarksWork   = w;
        NewRemarkText = "";
        RemarkError   = "";
        await using var db = await DbFactory.CreateDbContextAsync();
        RemarksList = await db.WorkRemarks
            .Where(r => r.WorkId == w.WorkId)
            .OrderBy(r => r.CreatedAt)
            .ToListAsync();
        ShowRemarksModal = true;
    }

    void CloseRemarks()
    {
        ShowRemarksModal = false;
        RemarksWork = null;
    }

    async Task AddRemark()
    {
        if (string.IsNullOrWhiteSpace(NewRemarkText))
        { RemarkError = "Remark cannot be empty."; return; }

        var auth        = await AuthState!;
        var authorName  = auth.User.Identity?.Name ?? "Unknown";
        var authorIdStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int? authorId   = authorIdStr is not null ? int.Parse(authorIdStr) : null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var remark = new WorkRemark
        {
            WorkId     = RemarksWork!.WorkId,
            Content    = NewRemarkText.Trim(),
            AuthorName = authorName,
            AuthorId   = authorId,
            CreatedAt  = DateTime.UtcNow
        };
        db.WorkRemarks.Add(remark);
        await db.SaveChangesAsync();

        LatestRemarksMap[RemarksWork.WorkId] = remark;
        NewRemarkText = "";
        RemarkError   = "";
        RemarksList = await db.WorkRemarks
            .Where(r => r.WorkId == RemarksWork!.WorkId)
            .OrderBy(r => r.CreatedAt)
            .ToListAsync();
    }

    // ── Add Work (XEN) ────────────────────────────────────────
    void OpenAddWork()
    {
        NewWork            = new Work();
        NewWorkStatusStr   = "ONGOING";
        NewWorkCategoryId  = NewWorkFundSourceId = "";
        NewWorkJenId       = NewWorkAenId = NewWorkXenId = "";
        AddWorkError       = "";
        ShowAddWorkModal   = true;
    }

    void CloseAddWork() => ShowAddWorkModal = false;

    async Task SaveNewWork()
    {
        AddWorkError = "";
        if (string.IsNullOrWhiteSpace(NewWork.WorkName))
        { AddWorkError = "Work name is required."; return; }

        try
        {
            NewWork.Status    = Enum.Parse<WorkStatus>(NewWorkStatusStr);
            NewWork.CreatedAt = DateTime.UtcNow;

            if (!string.IsNullOrEmpty(NewWorkCategoryId)   && int.TryParse(NewWorkCategoryId,   out var cid)) NewWork.CategoryId    = cid;
            if (!string.IsNullOrEmpty(NewWorkFundSourceId) && int.TryParse(NewWorkFundSourceId, out var fid)) NewWork.FundSourceId  = fid;
            if (!string.IsNullOrEmpty(NewWorkJenId)        && int.TryParse(NewWorkJenId,        out var jid)) NewWork.AssignedJenId = jid;
            if (!string.IsNullOrEmpty(NewWorkAenId)        && int.TryParse(NewWorkAenId,        out var aid)) NewWork.AssignedAenId = aid;
            if (!string.IsNullOrEmpty(NewWorkXenId)        && int.TryParse(NewWorkXenId,        out var xid)) NewWork.AssignedExenId = xid;

            await using var db = await DbFactory.CreateDbContextAsync();
            db.Works.Add(NewWork);
            await db.SaveChangesAsync();
            await AuditSvc.LogAsync(
                "works", NewWork.WorkId, AuditAction.INSERT,
                CurrentEngineerId,
                new { NewWork.WorkName, NewWork.Status });

            ShowAddWorkModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            AddWorkError = $"Error saving work: {ex.Message}";
        }
    }

    // ── Password Change ───────────────────────────────────────
    void OpenPasswordModal()
    {
        PwdCurrent = PwdNew = PwdConfirm = PwdError = PwdSuccess = "";
        ShowPasswordModal = true;
    }

    void ClosePasswordModal() => ShowPasswordModal = false;

    async Task ChangePassword()
    {
        PwdError = PwdSuccess = "";
        if (string.IsNullOrWhiteSpace(PwdCurrent) || string.IsNullOrWhiteSpace(PwdNew))
        { PwdError = "All fields are required."; return; }
        if (PwdNew != PwdConfirm)
        { PwdError = "New passwords do not match."; return; }
        if (PwdNew.Length < 6)
        { PwdError = "Password must be at least 6 characters."; return; }

        var auth  = await AuthState!;
        var idStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (idStr is null) { PwdError = "Session error. Please re-login."; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var eng = await db.Engineers.FindAsync(int.Parse(idStr));
        if (eng is null) { PwdError = "Account not found."; return; }
        if (!BCrypt.Net.BCrypt.Verify(PwdCurrent, eng.PasswordHash))
        { PwdError = "Current password is incorrect."; return; }

        eng.PasswordHash = BCrypt.Net.BCrypt.HashPassword(PwdNew);
        await db.SaveChangesAsync();
        PwdSuccess = "Password updated successfully.";
        PwdCurrent = PwdNew = PwdConfirm = "";
    }

    // ── Helpers ───────────────────────────────────────────────
    static string StatusLabel(WorkStatus s) => s switch
    {
        WorkStatus.ONGOING   => "Ongoing",
        WorkStatus.COMPLETED => "Completed",
        WorkStatus.STALLED   => "Stalled",
        WorkStatus.CANCELLED => "Cancelled",
        _                    => s.ToString()
    };

    static string ProgressColor(decimal pct) => pct switch
    {
        >= 75 => "progress-fill-green",
        >= 40 => "progress-fill-orange",
        _     => "progress-fill-red"
    };
}
