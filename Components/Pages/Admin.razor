
@page "/admin"
@attribute [Authorize(Roles = "ADMIN")]
@rendermode InteractiveServer
@inject IDbContextFactory<BdaDbContext> DbFactory
@inject NavigationManager Nav
@inject Work_Dashboard.Services.AuditService AuditSvc
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore
@using Work_Dashboard.Data
@using Work_Dashboard.Data.Entities
@using System.Security.Claims

<PageTitle>Admin — BDA Dashboard</PageTitle>

<div class="jen-shell">

    @* ── Sidebar ─────────────────────────────────────────────── *@
    <aside class="jen-sidebar">
        <div class="sidebar-brand">
            <img src="/images/bda-logo.png" alt="BDA" class="sidebar-logo" />
            <div>
                <div class="sidebar-title">BDA Admin</div>
                <div class="sidebar-subtitle">Management Panel</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <button class="nav-item @(Section == "overview"  ? "active" : "")" @onclick="NavigateToOverview">
                <i class="bi bi-speedometer2"></i><span>Overview</span>
            </button>
            <button class="nav-item @(Section == "users"     ? "active" : "")" @onclick='() => Section = "users"'>
                <i class="bi bi-people-fill"></i><span>Users</span>
            </button>
            <button class="nav-item @(Section == "works"     ? "active" : "")" @onclick='() => Section = "works"'>
                <i class="bi bi-hammer"></i><span>Works</span>
            </button>
            <button class="nav-item @(Section == "settings"  ? "active" : "")" @onclick='() => Section = "settings"'>
                <i class="bi bi-gear-fill"></i><span>Settings</span>
            </button>
        </nav>

        <div class="sidebar-footer">
            <button class="btn-logout w-100 mb-2" @onclick="OpenPasswordModal">
                <i class="bi bi-key-fill"></i> Change Password
            </button>
            <form method="post" action="/account/logout">
                <button type="submit" class="btn-logout w-100">
                    <i class="bi bi-box-arrow-left"></i> Logout
                </button>
            </form>
        </div>
    </aside>

    @* ── Main ───────────────────────────────────────────────── *@
    <main class="jen-main">

        <div class="jen-topbar">
            <div>
                <h5 class="mb-0 fw-bold">@SectionTitle</h5>
                <small class="text-muted">Bharatpur Development Authority</small>
            </div>
            <div class="topbar-user">
                <i class="bi bi-shield-lock-fill text-warning me-1"></i>
                <AuthorizeView><span>@context.User.Identity?.Name</span></AuthorizeView>
            </div>
        </div>

        @if (IsLoading)
        {
            <div class="d-flex justify-content-center align-items-center" style="height:60vh">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {

            @* ══ OVERVIEW ══════════════════════════════════════ *@
            if (Section == "overview")
            {
                <div class="row g-3 mb-3">
                    <div class="col-sm-6 col-xl-3">
                        <div class="stat-card border-start border-4 border-warning">
                            <div class="stat-label">Total Works</div>
                            <div class="stat-value">@AllWorks.Count</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="stat-card border-start border-4 border-primary">
                            <div class="stat-label">Ongoing</div>
                            <div class="stat-value text-primary">@AllWorks.Count(w => w.Status == WorkStatus.ONGOING && !w.IsAnnualContract)</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="stat-card border-start border-4 border-success">
                            <div class="stat-label">Completed</div>
                            <div class="stat-value text-success">@AllWorks.Count(w => w.Status == WorkStatus.COMPLETED)</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="stat-card border-start border-4 border-info">
                            <div class="stat-label">Annual Contract</div>
                            <div class="stat-value text-info">@AllWorks.Count(w => w.IsAnnualContract)</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="text-muted" style="font-size:0.83rem">Financial Year:</span>
                    <select class="filter-select-sm" @bind="OverviewYear" @bind:after="OnOverviewYearChanged">
                        <option value="0">All Years</option>
                        @foreach (var y in OverviewYears)
                        { <option value="@y">@y–@(y+1)</option> }
                    </select>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="content-card p-3">
                            <h6 class="fw-bold mb-3">Category Wise</h6>
                            <div id="chart-category" style="height:320px"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="content-card p-3">
                            <h6 class="fw-bold mb-3">Fund Source</h6>
                            <div id="chart-fund" style="height:320px"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="content-card p-3">
                            <h6 class="fw-bold mb-3">Scheme / Non-Scheme</h6>
                            <div id="chart-scheme" style="height:260px"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="content-card p-3">
                            <h6 class="fw-bold mb-3">CM Budget</h6>
                            <div id="chart-cmbudget" style="height:260px"></div>
                        </div>
                    </div>
                </div>
            }

            @* ══ USERS ══════════════════════════════════════════ *@
            if (Section == "users")
            {
                <div class="content-card">
                    @* ── Header ── *@
                    <div class="um-header">
                        <div class="um-title">
                            <i class="bi bi-people-fill me-2"></i>User Management
                        </div>
                        <button class="btn btn-sm btn-primary px-3" @onclick="OpenAddUser">
                            <i class="bi bi-plus-lg me-1"></i>Add User
                        </button>
                    </div>

                    @* ── Table ── *@
                    <div class="table-responsive">
                        <table class="table table-hover bda-table mb-0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Role</th>
                                    <th>Mobile No.</th>
                                    <th class="text-center" style="width:110px">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var eng in Engineers)
                                {
                                    <tr class="@(!eng.IsActive ? "um-row-inactive" : "")">
                                        <td>
                                            <div class="um-name">@eng.Name</div>
                                            <div class="um-username">@eng.Username</div>
                                        </td>
                                        <td>
                                            <span class="um-role-pill um-role-@eng.Role.ToString().ToLower()">
                                                @eng.Role
                                            </span>
                                        </td>
                                        <td class="um-mobile">@(eng.Mobile ?? "—")</td>
                                        <td class="text-center">
                                            <div class="d-flex gap-1 justify-content-center">
                                                <button class="um-action-btn um-btn-edit"
                                                        title="Edit user"
                                                        @onclick="() => OpenEditUser(eng)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="um-action-btn um-btn-delete"
                                                        title="@(eng.IsActive ? "Deactivate user" : "Activate user")"
                                                        @onclick="() => ConfirmDeleteUser(eng)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @* ══ WORKS ══════════════════════════════════════════ *@
            if (Section == "works")
            {
                @* ── Stat Cards ── *@
                <div class="row g-3 mb-3">
                    <div class="col-sm-6 col-lg-3">
                        <div class="wstat-card">
                            <div class="wstat-icon wstat-icon-blue">
                                <i class="bi bi-briefcase-fill"></i>
                            </div>
                            <div>
                                <div class="wstat-label">Total Works</div>
                                <div class="wstat-value">@AllWorks.Count</div>
                                <div class="wstat-sub">All works</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="wstat-card">
                            <div class="wstat-icon wstat-icon-orange">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                            <div>
                                <div class="wstat-label">Ongoing Works</div>
                                <div class="wstat-value">@AllWorks.Count(w => w.Status == WorkStatus.ONGOING)</div>
                                <div class="wstat-sub">In Progress</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="wstat-card">
                            <div class="wstat-icon wstat-icon-green">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div>
                                <div class="wstat-label">Completed Works</div>
                                <div class="wstat-value">@AllWorks.Count(w => w.Status == WorkStatus.COMPLETED)</div>
                                <div class="wstat-sub">Completed</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="wstat-card">
                            <div class="wstat-icon wstat-icon-red">
                                <i class="bi bi-exclamation-circle-fill"></i>
                            </div>
                            <div>
                                <div class="wstat-label">Delayed Works</div>
                                <div class="wstat-value">@AllWorks.Count(w => w.Status == WorkStatus.STALLED)</div>
                                <div class="wstat-sub">Delayed</div>
                            </div>
                        </div>
                    </div>
                </div>

                @* ── Filter Bar + Table ── *@
                <div class="content-card">
                    <div class="works-filter-bar">
                        <div class="d-flex align-items-center gap-2 flex-wrap">

                            @* File No Search *@
                            <div class="filter-search-wrap">
                                <i class="bi bi-search filter-search-icon"></i>
                                <input type="search" class="filter-search-input"
                                       placeholder="Search file no…"
                                       @bind="WorkSearchText" @bind:after="FilterWorks" />
                            </div>

                            @* Status *@
                            <div class="filter-group">
                                <span class="filter-group-label">Status</span>
                                <select class="filter-select-sm"
                                        @bind="WorkFilter" @bind:after="FilterWorks">
                                    <option value="ALL">All</option>
                                    <option value="ONGOING">Ongoing</option>
                                    <option value="COMPLETED">Completed</option>
                                    <option value="STALLED">Stalled</option>
                                </select>
                            </div>

                            @* JEN *@
                            <div class="filter-group">
                                <span class="filter-group-label">JEN</span>
                                <select class="filter-select-sm"
                                        @bind="WorkJenFilter" @bind:after="FilterWorks">
                                    <option value="">All</option>
                                    @foreach (var e in JenEngineers)
                                    { <option value="@e.EngineerId">@e.Name</option> }
                                </select>
                            </div>

                            @* AEN *@
                            <div class="filter-group">
                                <span class="filter-group-label">AEN</span>
                                <select class="filter-select-sm"
                                        @bind="WorkAenFilter" @bind:after="FilterWorks">
                                    <option value="">All</option>
                                    @foreach (var e in AenEngineers)
                                    { <option value="@e.EngineerId">@e.Name</option> }
                                </select>
                            </div>

                            @* XEN *@
                            <div class="filter-group">
                                <span class="filter-group-label">XEN</span>
                                <select class="filter-select-sm"
                                        @bind="WorkXenFilter" @bind:after="FilterWorks">
                                    <option value="">All</option>
                                    @foreach (var e in XenEngineers)
                                    { <option value="@e.EngineerId">@e.Name</option> }
                                </select>
                            </div>

                            @* Annual *@
                            <div class="filter-group">
                                <span class="filter-group-label">Annual</span>
                                <select class="filter-select-sm"
                                        @bind="WorkAnnualFilter" @bind:after="FilterWorks">
                                    <option value="ALL">All</option>
                                    <option value="YES">Annual Only</option>
                                    <option value="NO">Non-Annual</option>
                                </select>
                            </div>

                            @* Date Range *@
                            <div class="filter-daterange">
                                <i class="bi bi-calendar3 text-muted me-1"></i>
                                <input type="date" class="filter-date-input" placeholder="Start date"
                                       value="@WorkStartDateFilter"
                                       @onchange="@((ChangeEventArgs e) => { WorkStartDateFilter = e?.Value?.ToString() ?? ""; FilterWorks(); })" />
                                <span class="text-muted mx-1">—</span>
                                <input type="date" class="filter-date-input" placeholder="End date"
                                       value="@WorkEndDateFilter"
                                       @onchange="@((ChangeEventArgs e) => { WorkEndDateFilter = e?.Value?.ToString() ?? ""; FilterWorks(); })" />
                            </div>

                            @* Reset *@
                            <button class="btn-filter-reset" @onclick="ResetWorkFilters">
                                <i class="bi bi-arrow-clockwise"></i> Reset
                            </button>

                            @* Export + Add Work *@
                            <div class="ms-auto d-flex align-items-center gap-2">
                                <div class="export-btn-group">
                                    <button class="btn-export btn-export-csv" title="Download CSV" @onclick="ExportCsv">
                                        <i class="bi bi-filetype-csv"></i>
                                    </button>
                                    <button class="btn-export btn-export-xlsx" title="Download Excel" @onclick="ExportExcel">
                                        <i class="bi bi-file-earmark-excel-fill"></i>
                                    </button>
                                    <button class="btn-export btn-export-pdf" title="Download PDF" @onclick="ExportPdf">
                                        <i class="bi bi-file-earmark-pdf-fill"></i>
                                    </button>
                                </div>
                                <button class="btn btn-sm btn-primary px-3" @onclick="OpenAddWork">
                                    <i class="bi bi-plus-lg me-1"></i>Add Work
                                </button>
                            </div>
                        </div>
                    </div>

                    @* ── Works Table ── *@
                    <div class="table-responsive table-scroll-body">
                        <table class="table table-hover bda-table mb-0">
                            <thead class="thead-sticky">
                                <tr>
                                    <th style="width:44px">#</th>
                                    <th style="min-width:260px">Work Name / File No.</th>
                                    <th style="min-width:110px">Status</th>
                                    <th style="min-width:90px">Progress</th>
                                    <th style="min-width:110px">JEN</th>
                                    <th style="min-width:100px">AEN</th>
                                    <th style="min-width:100px">XEN</th>
                                    <th style="min-width:220px">Latest Remark</th>
                                    <th style="min-width:120px">Files</th>
                                    <th class="text-center" style="min-width:100px">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredWorks.Any())
                                {
                                    <tr><td colspan="10" class="text-center text-muted py-5">No records found.</td></tr>
                                }
                                @{ int wi = 1; }
                                @foreach (var w in FilteredWorks)
                                {
                                    var lr = LatestRemarksMap.GetValueOrDefault(w.WorkId);
                                    var remarkText = lr?.Content ?? (string.IsNullOrWhiteSpace(w.Remarks) ? null : w.Remarks);
                                    bool isExpanded = ExpandedWorkIds.Contains(w.WorkId);
                                    <tr class="@(isExpanded ? "work-row-expanded" : "")">
                                        <td class="text-muted fw-medium">@(wi++)</td>
                                        <td>
                                            <div class="d-flex align-items-start gap-1">
                                                <div class="flex-grow-1 min-w-0">
                                                    <div class="fw-semibold work-name-cell">@w.WorkName</div>
                                                    <div class="d-flex align-items-center gap-1 mt-1">
                                                        @if (w.WorkCode != null)
                                                        {
                                                            <span class="work-fileno"><i class="bi bi-folder2 me-1"></i>@w.WorkCode</span>
                                                        }
                                                        @if (w.IsAnnualContract)
                                                        {
                                                            <span class="badge badge-annual">Annual</span>
                                                        }
                                                    </div>
                                                </div>
                                                <button class="btn-expand-row" title="@(isExpanded ? "Collapse" : "Quick view")"
                                                        @onclick="() => ToggleExpand(w.WorkId)">
                                                    <i class="bi bi-chevron-@(isExpanded ? "up" : "down")"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="status-pill status-pill-@w.Status.ToString().ToLower()">
                                                <span class="status-dot"></span>@StatusLabel(w.Status)
                                            </span>
                                        </td>
                                        <td>
                                            @if (w.ProgressPercent.HasValue)
                                            {
                                                <div class="mini-prog-wrap">
                                                    <div class="mini-prog-bar">
                                                        <div class="mini-prog-fill @ProgColor(w.ProgressPercent.Value)"
                                                             style="width:@(w.ProgressPercent)%"></div>
                                                    </div>
                                                    <span class="mini-prog-label">@w.ProgressPercent%</span>
                                                </div>
                                            }
                                            else { <span class="text-muted">—</span> }
                                        </td>
                                        <td><span class="eng-name">@(w.AssignedJen?.Name ?? "—")</span></td>
                                        <td><span class="eng-name">@(w.AssignedAen?.Name ?? "—")</span></td>
                                        <td><span class="eng-name">@(w.AssignedExen?.Name ?? "—")</span></td>
                                        <td>
                                            @if (remarkText != null)
                                            {
                                                <div class="remark-preview">@remarkText</div>
                                                <button class="btn-read-more" @onclick="async () => await OpenEditWork(w)">Read more</button>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @{
                                                var pdfCount   = FileCounts.GetValueOrDefault(w.WorkId).pdfs;
                                                var photoCount = FileCounts.GetValueOrDefault(w.WorkId).photos;
                                            }
                                            <span class="files-badge-cell" @onclick="() => OpenFilesModal(w)" title="Click to manage files">
                                                <span class="files-pill files-pill-pdf @(pdfCount == 0 ? "empty" : "")">
                                                    <i class="bi bi-file-earmark-pdf-fill"></i>@pdfCount
                                                </span>
                                                <span class="files-pill files-pill-img @(photoCount == 0 ? "empty" : photoCount >= 10 ? "full" : "")">
                                                    <i class="bi bi-image-fill"></i>@photoCount/10
                                                </span>
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex gap-1 justify-content-center">
                                                <button class="action-btn action-btn-view" title="View Details"
                                                        @onclick="() => OpenDetail(w)">
                                                    <i class="bi bi-eye-fill"></i>
                                                </button>
                                                <button class="action-btn action-btn-edit" title="Edit / Remarks"
                                                        @onclick="async () => await OpenEditWork(w)">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                                <button class="action-btn action-btn-delete" title="Delete Work"
                                                        @onclick="() => { ConfirmDeleteWorkItem = w; ShowConfirmDeleteWork = true; }">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    @if (isExpanded)
                                    {
                                        <tr class="work-expand-row">
                                            <td colspan="10">
                                                <div class="work-expand-panel">
                                                    <div class="expand-fullname">@w.WorkName</div>
                                                    <div class="expand-grid">
                                                        <div class="expand-item">
                                                            <div class="expand-label">Physical Progress</div>
                                                            <div class="expand-val">
                                                                @if (w.ProgressPercent.HasValue)
                                                                {
                                                                    <div class="progress-pill mb-1">
                                                                        <div class="progress-fill @ProgColor(w.ProgressPercent.Value)"
                                                                             style="width:@(w.ProgressPercent)%"></div>
                                                                    </div>
                                                                    <text>@w.ProgressPercent%</text>
                                                                }
                                                                else { <text>—</text> }
                                                            </div>
                                                        </div>
                                                        <div class="expand-item">
                                                            <div class="expand-label">Financial Progress</div>
                                                            <div class="expand-val">@(w.FinancialProgressPercent.HasValue ? $"{w.FinancialProgressPercent}%" : "—")</div>
                                                        </div>
                                                        <div class="expand-item">
                                                            <div class="expand-label">Agreement Amount</div>
                                                            <div class="expand-val">@(w.AgreementAmount.HasValue ? $"₹ {w.AgreementAmount:N2} L" : "—")</div>
                                                        </div>
                                                        <div class="expand-item">
                                                            <div class="expand-label">Contractor</div>
                                                            <div class="expand-val">@(w.ContractorName ?? "—")</div>
                                                        </div>
                                                        <div class="expand-item">
                                                            <div class="expand-label">Start Date</div>
                                                            <div class="expand-val">@(w.StartDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                        </div>
                                                        <div class="expand-item">
                                                            <div class="expand-label">Expected Completion</div>
                                                            <div class="expand-val">@(w.ExpectedCompletion?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                        </div>
                                                        <div class="expand-item">
                                                            <div class="expand-label">Category</div>
                                                            <div class="expand-val">@(w.Category?.CategoryName ?? w.Category?.CategoryCode ?? "—")</div>
                                                        </div>
                                                        <div class="expand-item">
                                                            <div class="expand-label">Fund Source</div>
                                                            <div class="expand-val">@(w.FundSource?.SourceName ?? w.FundSource?.SourceCode ?? "—")</div>
                                                        </div>
                                                    </div>
                                                    @if (lr != null)
                                                    {
                                                        <div class="expand-remark">
                                                            <i class="bi bi-chat-left-text me-1 text-primary"></i>
                                                            <span class="text-muted" style="font-size:0.72rem">
                                                                @lr.AuthorName · @lr.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                                            </span>
                                                            <div class="expand-remark-text">@lr.Content</div>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @* ══ SETTINGS ═══════════════════════════════════════ *@
            if (Section == "settings")
            {
                <div class="row g-3 align-items-start">

                    @* ── Categories panel ── *@
                    <div class="col-md-6">
                        <div class="settings-panel-card">
                            <button class="settings-panel-trigger" @onclick="() => ShowCatsPanel = !ShowCatsPanel">
                                <i class="bi bi-tags-fill text-primary"></i>
                                <span class="fw-semibold">Categories</span>
                                <span class="badge bg-secondary ms-1">@Categories.Count</span>
                                <i class="bi bi-chevron-@(ShowCatsPanel ? "up" : "down") ms-auto"></i>
                            </button>
                            @if (ShowCatsPanel)
                            {
                                <div class="settings-panel-body">
                                    @foreach (var cat in Categories)
                                    {
                                        @if (InlineEditCatId == cat.CategoryId)
                                        {
                                            <div class="ref-row ref-edit-row">
                                                <input class="form-control form-control-sm me-1" @bind="InlineEditCatCode"
                                                       placeholder="Code" style="width:80px;text-transform:uppercase" />
                                                <input class="form-control form-control-sm me-1" @bind="InlineEditCatName"
                                                       placeholder="Full name" />
                                                <button class="btn btn-xs btn-success me-1" @onclick="SaveInlineCategory">✓</button>
                                                <button class="btn btn-xs btn-secondary" @onclick="() => InlineEditCatId = 0">✕</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="ref-row">
                                                <input class="form-check-input me-2 flex-shrink-0" type="checkbox"
                                                       checked="@cat.IsActive"
                                                       @onchange="() => ToggleCategoryActive(cat)"
                                                       title="@(cat.IsActive ? "Active – click to deactivate" : "Inactive – click to activate")" />
                                                <span class="badge @CatBadge(cat.CategoryCode) me-2">@cat.CategoryCode</span>
                                                <span class="flex-grow-1 @(!cat.IsActive ? "text-muted text-decoration-line-through" : "")">@cat.CategoryName</span>
                                                <span class="badge bg-light text-dark border me-2" style="font-size:0.7rem">
                                                    @AllWorks.Count(w => w.CategoryId == cat.CategoryId) works
                                                </span>
                                                <button class="btn btn-xs btn-link text-muted p-0" title="Edit"
                                                        @onclick="() => StartEditCategory(cat)">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                            </div>
                                        }
                                    }
                                    @if (ShowInlineAddCat)
                                    {
                                        <div class="ref-add-row">
                                            <input class="form-control form-control-sm me-1" @bind="NewCatCode"
                                                   placeholder="Code e.g. ROAD" style="width:100px;text-transform:uppercase" />
                                            <input class="form-control form-control-sm me-1" @bind="NewCatName"
                                                   placeholder="Full name" />
                                            <button class="btn btn-xs btn-success me-1" @onclick="SaveInlineNewCategory">Save</button>
                                            <button class="btn btn-xs btn-secondary" @onclick="() => { ShowInlineAddCat = false; NewCatCode = NewCatName = string.Empty; }">✕</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="ref-add-trigger" @onclick="OpenAddCat">
                                            <i class="bi bi-plus-circle me-1"></i> Add New Category
                                        </button>
                                    }
                                    @if (!string.IsNullOrEmpty(CatError))
                                    { <div class="px-3 pb-2"><small class="text-danger">@CatError</small></div> }
                                </div>
                            }
                        </div>
                    </div>

                    @* ── Fund Sources panel ── *@
                    <div class="col-md-6">
                        <div class="settings-panel-card">
                            <button class="settings-panel-trigger" @onclick="() => ShowFsPanel = !ShowFsPanel">
                                <i class="bi bi-cash-stack text-success"></i>
                                <span class="fw-semibold">Fund Sources</span>
                                <span class="badge bg-secondary ms-1">@FundSources.Count</span>
                                <i class="bi bi-chevron-@(ShowFsPanel ? "up" : "down") ms-auto"></i>
                            </button>
                            @if (ShowFsPanel)
                            {
                                <div class="settings-panel-body">
                                    @foreach (var fs in FundSources)
                                    {
                                        @if (InlineEditFsId == fs.FundSourceId)
                                        {
                                            <div class="ref-row ref-edit-row">
                                                <input class="form-control form-control-sm me-1" @bind="InlineEditFsCode"
                                                       placeholder="Code" style="width:80px;text-transform:uppercase" />
                                                <input class="form-control form-control-sm me-1" @bind="InlineEditFsName"
                                                       placeholder="Full name" />
                                                <button class="btn btn-xs btn-success me-1" @onclick="SaveInlineFundSource">✓</button>
                                                <button class="btn btn-xs btn-secondary" @onclick="() => InlineEditFsId = 0">✕</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="ref-row">
                                                <input class="form-check-input me-2 flex-shrink-0" type="checkbox"
                                                       checked="@fs.IsActive"
                                                       @onchange="() => ToggleFundSourceActive(fs)"
                                                       title="@(fs.IsActive ? "Active – click to deactivate" : "Inactive – click to activate")" />
                                                <code class="me-2 text-primary">@fs.SourceCode</code>
                                                <span class="flex-grow-1 @(!fs.IsActive ? "text-muted text-decoration-line-through" : "")">@fs.SourceName</span>
                                                <span class="badge bg-light text-dark border me-2" style="font-size:0.7rem">
                                                    @AllWorks.Count(w => w.FundSourceId == fs.FundSourceId) works
                                                </span>
                                                <button class="btn btn-xs btn-link text-muted p-0" title="Edit"
                                                        @onclick="() => StartEditFundSource(fs)">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                            </div>
                                        }
                                    }
                                    @if (ShowInlineAddFs)
                                    {
                                        <div class="ref-add-row">
                                            <input class="form-control form-control-sm me-1" @bind="NewFsCode"
                                                   placeholder="Code e.g. BDA" style="width:100px;text-transform:uppercase" />
                                            <input class="form-control form-control-sm me-1" @bind="NewFsName"
                                                   placeholder="Full name" />
                                            <button class="btn btn-xs btn-success me-1" @onclick="SaveInlineNewFundSource">Save</button>
                                            <button class="btn btn-xs btn-secondary" @onclick="() => { ShowInlineAddFs = false; NewFsCode = NewFsName = string.Empty; }">✕</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="ref-add-trigger" @onclick="OpenAddFs">
                                            <i class="bi bi-plus-circle me-1"></i> Add New Fund Source
                                        </button>
                                    }
                                    @if (!string.IsNullOrEmpty(FsError))
                                    { <div class="px-3 pb-2"><small class="text-danger">@FsError</small></div> }
                                </div>
                            }
                        </div>
                    </div>

                    @* ── Departments panel ── *@
                    <div class="col-md-6">
                        <div class="settings-panel-card">
                            <button class="settings-panel-trigger" @onclick="() => ShowDeptPanel = !ShowDeptPanel">
                                <i class="bi bi-building text-warning"></i>
                                <span class="fw-semibold">Departments</span>
                                <span class="badge bg-secondary ms-1">@DeptList.Count</span>
                                <i class="bi bi-chevron-@(ShowDeptPanel ? "up" : "down") ms-auto"></i>
                            </button>
                            @if (ShowDeptPanel)
                            {
                                <div class="settings-panel-body">
                                    @foreach (var dept in DeptList)
                                    {
                                        <div class="ref-row">
                                            <i class="bi bi-building me-2 text-muted"></i>
                                            <span class="flex-grow-1 fw-medium">@dept.Name</span>
                                            <span class="badge bg-light text-dark border" style="font-size:0.7rem">
                                                @AllWorks.Count(w => w.Department == dept.Name) works
                                            </span>
                                        </div>
                                    }
                                    @if (ShowInlineAddDept)
                                    {
                                        <div class="ref-add-row">
                                            <input class="form-control form-control-sm me-1" @bind="NewDeptName"
                                                   placeholder="Department name" />
                                            <button class="btn btn-xs btn-success me-1" @onclick="SaveNewDepartment">Save</button>
                                            <button class="btn btn-xs btn-secondary" @onclick="() => { ShowInlineAddDept = false; NewDeptName = string.Empty; }">✕</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="ref-add-trigger" @onclick="OpenAddDept">
                                            <i class="bi bi-plus-circle me-1"></i> Add Department
                                        </button>
                                    }
                                    @if (!string.IsNullOrEmpty(DeptError))
                                    { <div class="px-3 pb-2"><small class="text-danger">@DeptError</small></div> }
                                </div>
                            }
                        </div>
                    </div>

                    @* ── Status reference panel ── *@
                    <div class="col-md-6">
                        <div class="settings-panel-card">
                            <button class="settings-panel-trigger" @onclick="() => ShowStatusPanel = !ShowStatusPanel">
                                <i class="bi bi-circle-half text-info"></i>
                                <span class="fw-semibold">Work Statuses</span>
                                <span class="badge bg-secondary ms-1">4</span>
                                <i class="bi bi-chevron-@(ShowStatusPanel ? "up" : "down") ms-auto"></i>
                            </button>
                            @if (ShowStatusPanel)
                            {
                                <div class="settings-panel-body">
                                    @foreach (var (status, desc, badge) in StatusDefs)
                                    {
                                        <div class="ref-row">
                                            <span class="badge @badge me-3" style="min-width:90px;font-size:0.78rem">@status</span>
                                            <span class="flex-grow-1 text-muted" style="font-size:0.83rem">@desc</span>
                                            <span class="badge bg-light text-dark border" style="font-size:0.7rem">
                                                @AllWorks.Count(w => w.Status.ToString() == status) works
                                            </span>
                                        </div>
                                    }
                                    <div class="px-3 py-2">
                                        <small class="text-muted fst-italic">Statuses are fixed system values and cannot be modified.</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            }
        }

    </main>
</div>

@* ══ USER MODAL ═══════════════════════════════════════════════ *@
@if (ShowUserModal)
{
    <div class="modal-overlay" @onclick="CloseUserModal">
        <div class="modal-box" @onclick:stopPropagation>
            <div class="modal-box-header">
                <h6 class="mb-0 fw-bold">@(EditingUser.EngineerId == 0 ? "Add User" : "Edit User")</h6>
                <button class="btn-close" @onclick="CloseUserModal"></button>
            </div>
            <div class="modal-box-body">
                @if (!string.IsNullOrEmpty(UserError)) { <div class="alert alert-danger py-2">@UserError</div> }
                <div class="mb-3">
                    <label class="form-label fw-semibold">Full Name</label>
                    <input class="form-control" @bind="EditingUser.Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Username</label>
                    <input class="form-control" @bind="EditingUser.Username" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Password @(EditingUser.EngineerId != 0 ? "(blank = keep current)" : "")
                    </label>
                    <input type="password" class="form-control" @bind="UserPassword" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Role</label>
                        <select class="form-select" @bind="EditingUserRoleStr">
                            <option value="JEN">JEN (Junior Engineer)</option>
                            <option value="AEN">AEN (Asst. Engineer)</option>
                            <option value="XEN">XEN (Exec. Engineer)</option>
                            <option value="ADMIN">ADMIN</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Mobile</label>
                        <input class="form-control" type="tel" @bind="EditingUser.Mobile"
                               pattern="[0-9]{10}" maxlength="10" placeholder="10-digit mobile number" />
                    </div>
                </div>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-secondary btn-sm" @onclick="CloseUserModal">Cancel</button>
                <button class="btn btn-primary btn-sm" @onclick="SaveUser">
                    <i class="bi bi-check2 me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
}

@* ══ CONFIRM DELETE USER MODAL ════════════════════════════════ *@
@if (ShowConfirmDeleteUser && ConfirmDeleteEngineer != null)
{
    <div class="modal-overlay" @onclick="CloseConfirmDelete">
        <div class="modal-box" style="max-width:380px" @onclick:stopPropagation>
            <div class="modal-box-header">
                <h6 class="mb-0 fw-bold text-danger"><i class="bi bi-exclamation-triangle me-1"></i>Confirm Action</h6>
                <button class="btn-close" @onclick="CloseConfirmDelete"></button>
            </div>
            <div class="modal-box-body text-center py-3">
                <p class="mb-1">
                    @if (ConfirmDeleteEngineer.IsActive)
                    {
                        <text>Deactivate <strong>@ConfirmDeleteEngineer.Name</strong>?</text>
                    }
                    else
                    {
                        <text>Reactivate <strong>@ConfirmDeleteEngineer.Name</strong>?</text>
                    }
                </p>
                <small class="text-muted">
                    @if (ConfirmDeleteEngineer.IsActive)
                    {
                        <text>This user will no longer be able to log in.</text>
                    }
                    else
                    {
                        <text>This user will regain access to the system.</text>
                    }
                </small>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-secondary btn-sm" @onclick="CloseConfirmDelete">Cancel</button>
                <button class="btn @(ConfirmDeleteEngineer.IsActive ? "btn-danger" : "btn-success") btn-sm"
                        @onclick="ExecuteToggleUser">
                    @if (ConfirmDeleteEngineer.IsActive)
                    {
                        <text><i class="bi bi-person-dash me-1"></i>Deactivate</text>
                    }
                    else
                    {
                        <text><i class="bi bi-person-check me-1"></i>Reactivate</text>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* ══ CONFIRM DELETE WORK MODAL ════════════════════════════════ *@
@if (ShowConfirmDeleteWork && ConfirmDeleteWorkItem != null)
{
    <div class="modal-overlay" @onclick="() => { ShowConfirmDeleteWork = false; ConfirmDeleteWorkItem = null; }">
        <div class="modal-box" style="max-width:400px" @onclick:stopPropagation>
            <div class="modal-box-header">
                <h6 class="mb-0 fw-bold text-danger"><i class="bi bi-trash me-1"></i>Delete Work</h6>
                <button class="btn-close" @onclick="() => { ShowConfirmDeleteWork = false; ConfirmDeleteWorkItem = null; }"></button>
            </div>
            <div class="modal-box-body text-center py-3">
                <p class="mb-1">Delete <strong>@ConfirmDeleteWorkItem.WorkName</strong>?</p>
                <small class="text-muted">This work will be hidden from all views. This action can be undone by the database admin.</small>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-secondary btn-sm" @onclick="() => { ShowConfirmDeleteWork = false; ConfirmDeleteWorkItem = null; }">Cancel</button>
                <button class="btn btn-danger btn-sm" @onclick="SoftDeleteWork">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
}

@* ══ WORK EDIT MODAL ══════════════════════════════════════════ *@
@if (ShowWorkModal)
{
    <div class="modal-overlay" @onclick="CloseWorkModal">
        <div class="modal-box modal-box-lg" @onclick:stopPropagation>
            <div class="modal-box-header">
                <h6 class="mb-0 fw-bold">@(EditingWork.WorkId == 0 ? "Add Work" : "Edit Work")</h6>
                <button class="btn-close" @onclick="CloseWorkModal"></button>
            </div>
            <div class="modal-box-body">
                @if (!string.IsNullOrEmpty(WorkError)) { <div class="alert alert-danger py-2">@WorkError</div> }
                <div class="row">
                    <div class="col-12 mb-3">
                        <label class="form-label fw-semibold">Work Name <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="2" @bind="EditingWork.WorkName"></textarea>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">File No.</label>
                        <input class="form-control" @bind="EditingWork.WorkCode" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Category</label>
                        <select class="form-select" @bind="EditingWorkCategoryId">
                            <option value="">— Select —</option>
                            @foreach (var c in Categories) { <option value="@c.CategoryId">@c.CategoryCode — @c.CategoryName</option> }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Fund Source</label>
                        <select class="form-select" @bind="EditingWorkFundSourceId">
                            <option value="">— Select —</option>
                            @foreach (var f in FundSources) { <option value="@f.FundSourceId">@f.SourceCode — @f.SourceName</option> }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Department</label>
                        <input class="form-control" @bind="EditingWork.Department" placeholder="e.g. BDA, TOURISM" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">JEN</label>
                        <select class="form-select" @bind="EditingWorkJenId">
                            <option value="">— Select —</option>
                            @foreach (var e in JenEngineers) { <option value="@e.EngineerId">@e.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">AEN</label>
                        <select class="form-select" @bind="EditingWorkAenId">
                            <option value="">— Select —</option>
                            @foreach (var e in AenEngineers) { <option value="@e.EngineerId">@e.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">XEN</label>
                        <select class="form-select" @bind="EditingWorkXenId">
                            <option value="">— Select —</option>
                            @foreach (var e in XenEngineers) { <option value="@e.EngineerId">@e.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Status</label>
                        <select class="form-select" @bind="EditingWorkStatusStr">
                            <option value="ONGOING">ONGOING</option>
                            <option value="COMPLETED">COMPLETED</option>
                            <option value="STALLED">STALLED</option>
                            <option value="CANCELLED">CANCELLED</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Contractor Name</label>
                        <input class="form-control" @bind="EditingWork.ContractorName" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Contractor Mobile</label>
                        <input class="form-control" type="tel" @bind="EditingWork.ContractorMobile"
                               pattern="[0-9]{10}" maxlength="10" placeholder="10-digit mobile number" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Sanctioned Amount (लाखों)</label>
                        <input type="number" step="0.01" class="form-control" @bind="EditingWork.SanctionedAmount" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Agreement Amount (लाखों)</label>
                        <input type="number" step="0.01" class="form-control" @bind="EditingWork.AgreementAmount" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Start Date</label>
                        <input type="date" class="form-control" @bind="EditingWork.StartDate" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Expected Completion</label>
                        <input type="date" class="form-control" @bind="EditingWork.ExpectedCompletion" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Physical Progress %</label>
                        <input type="number" step="1" min="0" max="100" class="form-control" @bind="EditingWork.ProgressPercent" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Financial Progress %</label>
                        <input type="number" step="1" min="0" max="100" class="form-control" @bind="EditingWork.FinancialProgressPercent" />
                    </div>
                    <div class="col-12 mb-2">
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkAnnual" @bind="EditingWork.IsAnnualContract" />
                                <label class="form-check-label" for="chkAnnual">Annual Contract</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkScheme" @bind="EditingWork.IsScheme" />
                                <label class="form-check-label" for="chkScheme">Scheme (योजना)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkCm" @bind="EditingWork.IsCmBudget" />
                                <label class="form-check-label" for="chkCm">CM Budget</label>
                            </div>
                        </div>
                    </div>

                    @* ── Remarks section (edit only) ────────────────────── *@
                    @if (EditingWork.WorkId != 0)
                    {
                        <div class="col-12 mt-2">
                            <hr class="my-2" />
                            <p class="fw-semibold mb-2" style="font-size:0.85rem">
                                <i class="bi bi-chat-dots me-1 text-primary"></i>Remarks
                            </p>
                            @if (!string.IsNullOrWhiteSpace(EditingWork.Remarks))
                            {
                                <div class="remark-static mb-2">
                                    <div class="remark-meta"><i class="bi bi-pin-angle me-1"></i>Original note</div>
                                    <div class="remark-content">@EditingWork.Remarks</div>
                                </div>
                            }
                            @if (RemarksList.Any())
                            {
                                <div class="remarks-scroll mb-2">
                                    @foreach (var r in RemarksList)
                                    {
                                        bool isLast = r == RemarksList.Last();
                                        <div class="remark-entry">
                                            <div class="remark-meta">
                                                <i class="bi bi-person-circle me-1"></i>@r.AuthorName
                                                <span class="ms-2 text-muted" style="font-size:0.72rem">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                                                @if (isLast)
                                                {
                                                    <button class="ms-auto btn-remark-edit" title="Edit this remark"
                                                            @onclick="() => { EditingRemarkId = r.RemarkId; EditingRemarkText = r.Content; }">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                }
                                            </div>
                                            @if (isLast && EditingRemarkId == r.RemarkId)
                                            {
                                                <textarea class="form-control form-control-sm mt-1" rows="2" @bind="EditingRemarkText"></textarea>
                                                <div class="d-flex gap-1 mt-1">
                                                    <button class="btn btn-sm btn-primary" @onclick="SaveEditRemark">
                                                        <i class="bi bi-check2 me-1"></i>Save
                                                    </button>
                                                    <button class="btn btn-sm btn-secondary" @onclick="() => EditingRemarkId = 0">Cancel</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="remark-content">@r.Content</div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else if (string.IsNullOrWhiteSpace(EditingWork.Remarks))
                            {
                                <p class="text-muted" style="font-size:0.82rem"><i class="bi bi-info-circle me-1"></i>No remarks yet.</p>
                            }
                            <div class="remark-add-box">
                                @if (!string.IsNullOrEmpty(RemarkError)) { <div class="alert alert-danger py-1 mb-2" style="font-size:0.82rem">@RemarkError</div> }
                                <textarea class="form-control form-control-sm" rows="2"
                                          placeholder="Add a remark…"
                                          @bind="NewRemarkText"></textarea>
                                <div class="d-flex justify-content-end mt-1">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="AddRemark">
                                        <i class="bi bi-send-fill me-1"></i>Add Remark
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-secondary btn-sm" @onclick="CloseWorkModal">Cancel</button>
                <button class="btn btn-primary btn-sm" @onclick="SaveWork">
                    <i class="bi bi-check2 me-1"></i>Save Work
                </button>
            </div>
        </div>
    </div>
}

@* ══ WORK DETAIL MODAL ════════════════════════════════════════ *@
@if (ShowDetailModal && DetailWork != null)
{
    <div class="modal-overlay" @onclick="CloseDetail">
        <div class="modal-box modal-box-lg" style="max-width:680px" @onclick:stopPropagation>
            <div class="modal-box-header">
                <div>
                    <h6 class="mb-0 fw-bold">Work Details</h6>
                    @if (DetailWork.WorkCode != null)
                    { <small class="text-muted">📁 @DetailWork.WorkCode</small> }
                </div>
                <button class="btn-close" @onclick="CloseDetail"></button>
            </div>
            <div class="modal-box-body">

                <p class="detail-section-title">Basic Information</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Work Name</div>
                        <div class="detail-val">@DetailWork.WorkName</div>
                    </div>
                    <div>
                        <div class="detail-label">File No. / Work Code</div>
                        <div class="detail-val">@(DetailWork.WorkCode ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Category</div>
                        <div class="detail-val">
                            @if (DetailWork.Category != null)
                            { <span class="badge @CatBadge(DetailWork.Category.CategoryCode)">@DetailWork.Category.CategoryCode</span> }
                            else { <text>—</text> }
                        </div>
                    </div>
                    <div>
                        <div class="detail-label">Status</div>
                        <div class="detail-val">
                            <span class="status-pill status-pill-@DetailWork.Status.ToString().ToLower()">
                                <span class="status-dot"></span>@StatusLabel(DetailWork.Status)
                            </span>
                        </div>
                    </div>
                    <div>
                        <div class="detail-label">Department</div>
                        <div class="detail-val">@(DetailWork.Department ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Fund Source</div>
                        <div class="detail-val">@(DetailWork.FundSource?.SourceName ?? DetailWork.FundSource?.SourceCode ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Flags</div>
                        <div class="detail-val">
                            @if (DetailWork.IsScheme)         { <span class="badge bg-primary me-1" style="font-size:0.65rem">Scheme</span> }
                            @if (DetailWork.IsCmBudget)       { <span class="badge bg-success me-1" style="font-size:0.65rem">CM Budget</span> }
                            @if (DetailWork.IsAnnualContract) { <span class="badge bg-info text-dark" style="font-size:0.65rem">Annual</span> }
                            @if (!DetailWork.IsScheme && !DetailWork.IsCmBudget && !DetailWork.IsAnnualContract) { <text>—</text> }
                        </div>
                    </div>
                </div>

                <p class="detail-section-title">Engineers</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">JEN</div>
                        <div class="detail-val">@(DetailWork.AssignedJen?.Name ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">AEN</div>
                        <div class="detail-val">@(DetailWork.AssignedAen?.Name ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Executive Engineer (XEN)</div>
                        <div class="detail-val">@(DetailWork.AssignedExen?.Name ?? "—")</div>
                    </div>
                </div>

                <p class="detail-section-title">Financial</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Sanctioned Amount (लाखों)</div>
                        <div class="detail-val">@(DetailWork.SanctionedAmount?.ToString("N2") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Agreement Amount (लाखों)</div>
                        <div class="detail-val">@(DetailWork.AgreementAmount?.ToString("N2") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Expenditure (लाखों)</div>
                        <div class="detail-val">@(DetailWork.Expenditure?.ToString("N2") ?? "—")</div>
                    </div>
                </div>

                <p class="detail-section-title">Progress &amp; Dates</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Start Date</div>
                        <div class="detail-val">@(DetailWork.StartDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Expected Completion</div>
                        <div class="detail-val">@(DetailWork.ExpectedCompletion?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Physical Progress</div>
                        <div class="detail-val">
                            @if (DetailWork.ProgressPercent.HasValue)
                            {
                                <div class="progress-pill mb-1">
                                    <div class="progress-fill @ProgColor(DetailWork.ProgressPercent.Value)"
                                         style="width:@(DetailWork.ProgressPercent)%"></div>
                                </div>
                                @($"{DetailWork.ProgressPercent}%")
                            }
                            else { <text>—</text> }
                        </div>
                    </div>
                    <div>
                        <div class="detail-label">Financial Progress</div>
                        <div class="detail-val">@(DetailWork.FinancialProgressPercent.HasValue ? $"{DetailWork.FinancialProgressPercent}%" : "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Actual Completion</div>
                        <div class="detail-val">@(DetailWork.ActualCompletion?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                </div>

                <p class="detail-section-title">Contractor</p>
                <div class="detail-grid">
                    <div>
                        <div class="detail-label">Contractor Name</div>
                        <div class="detail-val">@(DetailWork.ContractorName ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Contractor Mobile</div>
                        <div class="detail-val">@(DetailWork.ContractorMobile ?? "—")</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(DetailWork.Remarks))
                {
                    <p class="detail-section-title">Remarks</p>
                    <div class="remark-static">
                        <div class="remark-content" style="white-space:pre-wrap">@DetailWork.Remarks</div>
                    </div>
                }

            </div>
            <div class="modal-box-footer">
                <button class="btn btn-secondary btn-sm" @onclick="CloseDetail">Close</button>
                <button class="btn btn-primary btn-sm" @onclick="async () => { var w = DetailWork; if (w != null) { CloseDetail(); await OpenEditWork(w); } }">
                    <i class="bi bi-pencil me-1"></i>Edit / Remarks
                </button>
            </div>
        </div>
    </div>
}

@* ══ CHANGE PASSWORD MODAL ═════════════════════════════════════ *@
@if (ShowPasswordModal)
{
    <div class="modal-overlay" @onclick="ClosePasswordModal">
        <div class="modal-box" style="max-width:380px" @onclick:stopPropagation>
            <div class="modal-box-header">
                <h6 class="mb-0 fw-bold"><i class="bi bi-key-fill me-1"></i>Change Password</h6>
                <button class="btn-close" @onclick="ClosePasswordModal"></button>
            </div>
            <div class="modal-box-body">
                @if (!string.IsNullOrEmpty(PwdError))   { <div class="alert alert-danger py-2">@PwdError</div> }
                @if (!string.IsNullOrEmpty(PwdSuccess)) { <div class="alert alert-success py-2">@PwdSuccess</div> }
                <div class="mb-3">
                    <label class="form-label fw-semibold">Current Password</label>
                    <input type="password" class="form-control" @bind="PwdCurrent" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">New Password</label>
                    <input type="password" class="form-control" @bind="PwdNew" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Confirm New Password</label>
                    <input type="password" class="form-control" @bind="PwdConfirm" />
                </div>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-secondary btn-sm" @onclick="ClosePasswordModal">Close</button>
                <button class="btn btn-primary btn-sm" @onclick="ChangePassword">
                    <i class="bi bi-check2 me-1"></i>Update Password
                </button>
            </div>
        </div>
    </div>
}

@* ══ FILES MODAL ══════════════════════════════════════════════ *@
<Work_Dashboard.Components.Shared.WorkFilesModal
    Work="@FilesModalWork"
    UploadedById="@CurrentEngineerId"
    CanUpload="true"
    CanDelete="true"
    OnClose="CloseFilesModal"
    OnChanged="ReloadFileCountsAsync" />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    string Section            = "overview";
    bool   IsLoading          = true;
    int?   CurrentEngineerId  = null;

    // ── Data ──────────────────────────────────────────────────
    List<Work>         AllWorks      = [];
    List<Work>         FilteredWorks = [];
    List<Engineer>     Engineers     = [];
    List<WorkCategory> Categories    = [];
    List<FundSource>   FundSources   = [];
    List<Engineer>     JenEngineers  = [];
    List<Engineer>     AenEngineers  = [];
    List<Engineer>     XenEngineers  = [];
    Dictionary<int, WorkRemark> LatestRemarksMap = [];

    // Files modal
    Work? FilesModalWork = null;
    Dictionary<int, (int pdfs, int photos)> FileCounts = new();

    void OpenFilesModal(Work w) => FilesModalWork = w;
    void CloseFilesModal()      => FilesModalWork = null;

    async Task ReloadFileCountsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        FileCounts = await db.WorkFiles
            .GroupBy(f => f.WorkId)
            .Select(g => new
            {
                WorkId = g.Key,
                Pdfs   = g.Count(x => x.FileType == WorkFileType.pdf),
                Photos = g.Count(x => x.FileType == WorkFileType.image)
            })
            .ToDictionaryAsync(x => x.WorkId, x => (x.Pdfs, x.Photos));
    }

    // ── Works filter ──────────────────────────────────────────
    string WorkFilter          = "ALL";
    string WorkSearchText      = "";
    string WorkJenFilter       = "";
    string WorkAenFilter       = "";
    string WorkXenFilter       = "";
    string WorkAnnualFilter    = "ALL";
    string WorkStartDateFilter = "";
    string WorkEndDateFilter   = "";

    // ── User modal ────────────────────────────────────────────
    bool      ShowUserModal            = false;
    Engineer  EditingUser              = new();
    string    UserPassword             = "";
    string    EditingUserRoleStr       = "JEN";
    string    UserError                = "";

    // ── Confirm delete/toggle user ────────────────────────────
    bool      ShowConfirmDeleteUser    = false;
    Engineer? ConfirmDeleteEngineer    = null;

    void ConfirmDeleteUser(Engineer eng)
    {
        ConfirmDeleteEngineer = eng;
        ShowConfirmDeleteUser = true;
    }

    void CloseConfirmDelete()
    {
        ShowConfirmDeleteUser = false;
        ConfirmDeleteEngineer = null;
    }

    async Task ExecuteToggleUser()
    {
        if (ConfirmDeleteEngineer is null) return;
        await ToggleUserActive(ConfirmDeleteEngineer);
        CloseConfirmDelete();
    }

    // ── Work modal ────────────────────────────────────────────
    bool   ShowWorkModal         = false;
    Work   EditingWork           = new();
    string EditingWorkStatusStr    = "ONGOING";
    string EditingWorkCategoryId   = "";
    string EditingWorkFundSourceId = "";
    string EditingWorkJenId        = "";
    string EditingWorkAenId        = "";
    string EditingWorkXenId        = "";
    string WorkError               = "";

    // ── Work detail modal ─────────────────────────────────────
    bool  ShowDetailModal = false;
    Work? DetailWork      = null;

    // ── Work delete confirm ───────────────────────────────────
    bool  ShowConfirmDeleteWork = false;
    Work? ConfirmDeleteWorkItem = null;

    // ── Overview charts ───────────────────────────────────────
    int        OverviewYear   = 0;
    List<int>  OverviewYears  = [];
    bool       _chartsReady   = false;

    IEnumerable<Work> OverviewWorks =>
        OverviewYear == 0 ? AllWorks : AllWorks.Where(w => w.StartDate?.Year == OverviewYear);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Section == "overview" && !IsLoading && !_chartsReady)
        {
            _chartsReady = true;
            await RenderOverviewCharts();
        }
    }

    async Task NavigateToOverview()
    {
        Section = "overview";
        _chartsReady = false;
        StateHasChanged();
    }

    async Task OnOverviewYearChanged()
    {
        await RenderOverviewCharts();
    }

    async Task RenderOverviewCharts()
    {
        var ov = OverviewWorks.ToList();

        var categoryData = ov
            .GroupBy(w => w.Category?.CategoryCode ?? "N/A")
            .Select(g => new { label = g.Key, amount = (double)g.Sum(w => w.AgreementAmount ?? 0), count = g.Count() })
            .ToArray();

        var fundData = ov
            .GroupBy(w => w.FundSource?.SourceCode ?? "N/A")
            .Select(g => new { label = g.Key, amount = (double)g.Sum(w => w.AgreementAmount ?? 0), count = g.Count() })
            .ToArray();

        var schemeData = new[]
        {
            new { label = "Scheme",     amount = (double)ov.Where(w =>  w.IsScheme).Sum(w => w.AgreementAmount ?? 0), count = ov.Count(w =>  w.IsScheme) },
            new { label = "Non-Scheme", amount = (double)ov.Where(w => !w.IsScheme).Sum(w => w.AgreementAmount ?? 0), count = ov.Count(w => !w.IsScheme) }
        };

        var cmData = new[]
        {
            new { label = "CM Budget",     amount = (double)ov.Where(w =>  w.IsCmBudget).Sum(w => w.AgreementAmount ?? 0), count = ov.Count(w =>  w.IsCmBudget) },
            new { label = "Non-CM Budget", amount = (double)ov.Where(w => !w.IsCmBudget).Sum(w => w.AgreementAmount ?? 0), count = ov.Count(w => !w.IsCmBudget) }
        };

        await JS.InvokeVoidAsync("bdaCharts.renderCategoryBar", "chart-category", categoryData);
        await JS.InvokeVoidAsync("bdaCharts.renderFundDonut",   "chart-fund",     fundData);
        await JS.InvokeVoidAsync("bdaCharts.renderSemiDonut",   "chart-scheme",   schemeData);
        await JS.InvokeVoidAsync("bdaCharts.renderSemiDonut",   "chart-cmbudget", cmData);
    }

    // ── Inline expand ─────────────────────────────────────────
    HashSet<int> ExpandedWorkIds = new();
    void ToggleExpand(int workId) { if (!ExpandedWorkIds.Remove(workId)) ExpandedWorkIds.Add(workId); }

    // ── Remarks (inline in edit modal) ────────────────────────
    Work?            RemarksWork      = null;
    List<WorkRemark> RemarksList      = [];
    string           NewRemarkText    = "";
    string           RemarkError      = "";
    int              EditingRemarkId  = 0;
    string           EditingRemarkText = "";

    // ── Settings – Categories panel ───────────────────────────
    bool   ShowCatsPanel    = false;
    bool   ShowInlineAddCat = false;
    string NewCatCode       = "";
    string NewCatName       = "";
    int    InlineEditCatId  = 0;
    string InlineEditCatCode = "";
    string InlineEditCatName = "";
    string CatError          = "";

    // ── Settings – Fund Sources panel ─────────────────────────
    bool   ShowFsPanel     = false;
    bool   ShowInlineAddFs = false;
    string NewFsCode       = "";
    string NewFsName       = "";
    int    InlineEditFsId  = 0;
    string InlineEditFsCode = "";
    string InlineEditFsName = "";
    string FsError          = "";

    // ── Settings – Departments panel ──────────────────────────
    bool          ShowDeptPanel    = false;
    bool          ShowInlineAddDept = false;
    string        NewDeptName      = "";
    string        DeptError        = "";
    List<DeptItem> DeptList        = [];

    record DeptItem(string Name);

    // ── Settings – Status panel ───────────────────────────────
    bool ShowStatusPanel = false;

    static readonly (string status, string desc, string badge)[] StatusDefs =
    [
        ("ONGOING",   "Work is currently in progress",           "bg-warning text-dark"),
        ("COMPLETED", "Work has been fully completed",           "bg-success"),
        ("STALLED",   "Work is blocked or temporarily stopped",  "bg-danger"),
        ("CANCELLED", "Work was cancelled / not proceeding",     "bg-secondary"),
    ];

    // ── Password change modal ─────────────────────────────────
    bool   ShowPasswordModal = false;
    string PwdCurrent = "";
    string PwdNew     = "";
    string PwdConfirm = "";
    string PwdError   = "";
    string PwdSuccess = "";

    string SectionTitle => Section switch
    {
        "overview" => "Overview",
        "users"    => "User Management",
        "works"    => "Works Management",
        "settings" => "Settings",
        _          => ""
    };

    protected override async Task OnInitializedAsync()
    {
        var auth  = await AuthState!;
        var idStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (idStr is not null && int.TryParse(idStr, out var id))
            CurrentEngineerId = id;

        await LoadAll();
        IsLoading = false;
    }

    async Task LoadAll()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        AllWorks = await db.Works
            .Where(w => !w.IsDeleted)
            .Include(w => w.Category)
            .Include(w => w.FundSource)
            .Include(w => w.AssignedJen)
            .Include(w => w.AssignedAen)
            .Include(w => w.AssignedExen)
            .OrderByDescending(w => w.CreatedAt)
            .ToListAsync();

        Engineers    = await db.Engineers.Where(e => !e.IsDeleted).OrderBy(e => e.Name).ToListAsync();
        Categories   = await db.WorkCategories.OrderBy(c => c.CategoryCode).ToListAsync();
        FundSources  = await db.FundSources.OrderBy(f => f.SourceCode).ToListAsync();
        JenEngineers = Engineers.Where(e => e.Role == EngineerRole.JEN).ToList();
        AenEngineers = Engineers.Where(e => e.Role == EngineerRole.AEN).ToList();
        XenEngineers = Engineers.Where(e => e.Role == EngineerRole.XEN).ToList();

        // Latest remark per work
        var allRemarks = await db.WorkRemarks.OrderBy(r => r.CreatedAt).ToListAsync();
        LatestRemarksMap = allRemarks
            .GroupBy(r => r.WorkId)
            .ToDictionary(g => g.Key, g => g.Last());

        // File counts per work
        await ReloadFileCountsAsync();

        // Overview year dropdown
        OverviewYears = AllWorks
            .Where(w => w.StartDate.HasValue)
            .Select(w => w.StartDate!.Value.Year)
            .Distinct()
            .OrderByDescending(y => y)
            .ToList();

        // Departments: union of DB-stored list + distinct values from works
        var fromWorks = AllWorks
            .Where(w => !string.IsNullOrWhiteSpace(w.Department))
            .Select(w => w.Department!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase);
        DeptList = DeptList
            .Select(d => d.Name)
            .Union(fromWorks, StringComparer.OrdinalIgnoreCase)
            .OrderBy(d => d)
            .Select(d => new DeptItem(d))
            .ToList();

        FilterWorks();
    }

    void FilterWorks()
    {
        var q = AllWorks.AsEnumerable();

        // Status filter
        q = WorkFilter switch
        {
            "ONGOING"   => q.Where(w => w.Status == WorkStatus.ONGOING),
            "COMPLETED" => q.Where(w => w.Status == WorkStatus.COMPLETED),
            "STALLED"   => q.Where(w => w.Status == WorkStatus.STALLED),
            _           => q
        };

        // File no search
        if (!string.IsNullOrWhiteSpace(WorkSearchText))
        {
            var t = WorkSearchText.Trim();
            q = q.Where(w => w.WorkCode != null && w.WorkCode.Contains(t, StringComparison.OrdinalIgnoreCase));
        }

        // Engineer filters
        if (!string.IsNullOrEmpty(WorkJenFilter) && int.TryParse(WorkJenFilter, out var jenId))
            q = q.Where(w => w.AssignedJenId == jenId);
        if (!string.IsNullOrEmpty(WorkAenFilter) && int.TryParse(WorkAenFilter, out var aenId))
            q = q.Where(w => w.AssignedAenId == aenId);
        if (!string.IsNullOrEmpty(WorkXenFilter) && int.TryParse(WorkXenFilter, out var xenId))
            q = q.Where(w => w.AssignedExenId == xenId);

        // Annual contract filter
        if (WorkAnnualFilter == "YES") q = q.Where(w => w.IsAnnualContract);
        if (WorkAnnualFilter == "NO")  q = q.Where(w => !w.IsAnnualContract);

        // Date range filters
        if (!string.IsNullOrWhiteSpace(WorkStartDateFilter) && DateOnly.TryParse(WorkStartDateFilter, out var startDate))
            q = q.Where(w => w.StartDate >= startDate);
        if (!string.IsNullOrWhiteSpace(WorkEndDateFilter) && DateOnly.TryParse(WorkEndDateFilter, out var endDate))
            q = q.Where(w => w.ExpectedCompletion <= endDate || w.ActualCompletion <= endDate);

        FilteredWorks = q.ToList();
    }

    void ResetWorkFilters()
    {
        WorkFilter = "ALL";
        WorkSearchText = "";
        WorkJenFilter = WorkAenFilter = WorkXenFilter = "";
        WorkAnnualFilter = "ALL";
        WorkStartDateFilter = WorkEndDateFilter = "";
        FilterWorks();
    }

    // ── User CRUD ─────────────────────────────────────────────
    void OpenAddUser()
    {
        EditingUser = new Engineer(); UserPassword = ""; EditingUserRoleStr = "JEN"; UserError = "";
        ShowUserModal = true;
    }

    void OpenEditUser(Engineer eng)
    {
        EditingUser = new Engineer
        {
            EngineerId = eng.EngineerId, Name = eng.Name, Username = eng.Username,
            PasswordHash = eng.PasswordHash, Role = eng.Role, Mobile = eng.Mobile,
            Email = eng.Email, IsActive = eng.IsActive
        };
        UserPassword = ""; EditingUserRoleStr = eng.Role.ToString(); UserError = "";
        ShowUserModal = true;
    }

    void CloseUserModal() => ShowUserModal = false;

    async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(EditingUser.Name) || string.IsNullOrWhiteSpace(EditingUser.Username))
        { UserError = "Name and Username are required."; return; }
        if (EditingUser.EngineerId == 0 && string.IsNullOrWhiteSpace(UserPassword))
        { UserError = "Password is required for new users."; return; }

        try
        {
            EditingUser.Role = Enum.Parse<EngineerRole>(EditingUserRoleStr);
            await using var db = await DbFactory.CreateDbContextAsync();

            bool isNew = EditingUser.EngineerId == 0;
            if (isNew)
            {
                EditingUser.PasswordHash = BCrypt.Net.BCrypt.HashPassword(UserPassword);
                EditingUser.CreatedAt = DateTime.UtcNow;
                db.Engineers.Add(EditingUser);
            }
            else
            {
                var ex = await db.Engineers.FindAsync(EditingUser.EngineerId);
                if (ex is null) { UserError = "User not found."; return; }
                ex.Name = EditingUser.Name;
                ex.Username = EditingUser.Username;
                ex.Role = EditingUser.Role;
                ex.Mobile = EditingUser.Mobile;
                ex.Email = EditingUser.Email;
                ex.UpdatedAt = DateTime.UtcNow;
                if (!string.IsNullOrWhiteSpace(UserPassword))
                    ex.PasswordHash = BCrypt.Net.BCrypt.HashPassword(UserPassword);
                db.Engineers.Update(ex);
            }
            await db.SaveChangesAsync();
            await AuditSvc.LogAsync(
                "engineers", EditingUser.EngineerId,
                isNew ? AuditAction.INSERT : AuditAction.UPDATE,
                CurrentEngineerId,
                new { EditingUser.Name, EditingUser.Username, EditingUser.Role });
            ShowUserModal = false;
            UserError = "";
            await LoadAll();
        }
        catch (Exception ex)
        {
            UserError = $"Error saving user: {ex.Message}";
        }
    }

    async Task ToggleUserActive(Engineer eng)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var e = await db.Engineers.FindAsync(eng.EngineerId);
        if (e is not null)
        {
            e.IsActive = !e.IsActive;
            await db.SaveChangesAsync();
            await AuditSvc.LogAsync(
                "engineers", e.EngineerId, AuditAction.UPDATE,
                CurrentEngineerId,
                new { e.IsActive });
        }
        await LoadAll();
    }

    // ── Work CRUD ─────────────────────────────────────────────
    void OpenAddWork()
    {
        EditingWork = new Work(); EditingWorkStatusStr = "ONGOING";
        EditingWorkCategoryId = EditingWorkFundSourceId = EditingWorkJenId =
        EditingWorkAenId = EditingWorkXenId = WorkError = "";
        ShowWorkModal = true;
    }

    async Task OpenEditWork(Work w)
    {
        if (w == null) return;

        EditingWork = new Work
        {
            WorkId = w.WorkId, WorkName = w.WorkName, WorkCode = w.WorkCode,
            CategoryId = w.CategoryId, FundSourceId = w.FundSourceId, Department = w.Department,
            AssignedJenId = w.AssignedJenId, AssignedAenId = w.AssignedAenId, AssignedExenId = w.AssignedExenId,
            ContractorName = w.ContractorName, ContractorMobile = w.ContractorMobile,
            SanctionedAmount = w.SanctionedAmount, AgreementAmount = w.AgreementAmount,
            ProgressPercent = w.ProgressPercent, FinancialProgressPercent = w.FinancialProgressPercent,
            Status = w.Status, IsAnnualContract = w.IsAnnualContract, IsScheme = w.IsScheme,
            IsCmBudget = w.IsCmBudget, StartDate = w.StartDate, ExpectedCompletion = w.ExpectedCompletion,
            Remarks = w.Remarks
        };
        EditingWorkStatusStr    = w.Status.ToString();
        EditingWorkCategoryId   = w.CategoryId?.ToString() ?? "";
        EditingWorkFundSourceId = w.FundSourceId?.ToString() ?? "";
        EditingWorkJenId        = w.AssignedJenId?.ToString() ?? "";
        EditingWorkAenId        = w.AssignedAenId?.ToString() ?? "";
        EditingWorkXenId        = w.AssignedExenId?.ToString() ?? "";
        WorkError = ""; NewRemarkText = ""; RemarkError = "";
        RemarksWork = w;

        // Load existing remarks so the remarks panel is ready
        await using var db = await DbFactory.CreateDbContextAsync();
        RemarksList = await db.WorkRemarks
            .Where(r => r.WorkId == w.WorkId)
            .OrderBy(r => r.CreatedAt)
            .ToListAsync();

        ShowWorkModal = true;
    }

    void CloseWorkModal() { ShowWorkModal = false; RemarksWork = null; RemarksList = []; }

    async Task SaveWork()
    {
        if (string.IsNullOrWhiteSpace(EditingWork.WorkName)) { WorkError = "Work Name is required."; return; }
        EditingWork.Status         = Enum.Parse<WorkStatus>(EditingWorkStatusStr);
        EditingWork.CategoryId     = string.IsNullOrEmpty(EditingWorkCategoryId)   ? null : int.Parse(EditingWorkCategoryId);
        EditingWork.FundSourceId   = string.IsNullOrEmpty(EditingWorkFundSourceId) ? null : int.Parse(EditingWorkFundSourceId);
        EditingWork.AssignedJenId  = string.IsNullOrEmpty(EditingWorkJenId)        ? null : int.Parse(EditingWorkJenId);
        EditingWork.AssignedAenId  = string.IsNullOrEmpty(EditingWorkAenId)        ? null : int.Parse(EditingWorkAenId);
        EditingWork.AssignedExenId = string.IsNullOrEmpty(EditingWorkXenId)        ? null : int.Parse(EditingWorkXenId);

        await using var db = await DbFactory.CreateDbContextAsync();
        bool isNewWork = EditingWork.WorkId == 0;
        if (isNewWork) db.Works.Add(EditingWork);
        else
        {
            var ex = await db.Works.FindAsync(EditingWork.WorkId);
            if (ex is null) return;
            db.Entry(ex).CurrentValues.SetValues(EditingWork);
        }
        await db.SaveChangesAsync();
        await AuditSvc.LogAsync(
            "works", EditingWork.WorkId,
            isNewWork ? AuditAction.INSERT : AuditAction.UPDATE,
            CurrentEngineerId,
            new { EditingWork.WorkName, EditingWork.Status });
        ShowWorkModal = false;
        await LoadAll();
    }

