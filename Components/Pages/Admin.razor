    void OpenDetail(Work w) { DetailWork = w; ShowDetailModal = true; }
    void CloseDetail()      { ShowDetailModal = false; DetailWork = null; }

    // ── Remarks (inline in edit modal) ────────────────────────
    async Task AddRemark()
    {
        if (string.IsNullOrWhiteSpace(NewRemarkText)) { RemarkError = "Remark cannot be empty."; return; }
        if (RemarksWork is null) return;

        var auth       = await AuthState!;
        var authorName = auth.User.Identity?.Name ?? "Admin";
        var idStr      = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int? authorId  = idStr is not null ? int.Parse(idStr) : null;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.WorkRemarks.Add(new WorkRemark
        {
            WorkId = RemarksWork.WorkId, Content = NewRemarkText.Trim(),
            AuthorName = authorName, AuthorId = authorId, CreatedAt = DateTime.UtcNow
        });
        await db.SaveChangesAsync();
        NewRemarkText = ""; RemarkError = "";
        RemarksList = await db.WorkRemarks
            .Where(r => r.WorkId == RemarksWork.WorkId)
            .OrderBy(r => r.CreatedAt)
            .ToListAsync();

        // Keep the latest remark map in sync for the table column
        LatestRemarksMap[RemarksWork.WorkId] = RemarksList.Last();
    }

    async Task SaveEditRemark()
    {
        if (EditingRemarkId == 0 || string.IsNullOrWhiteSpace(EditingRemarkText)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var r = await db.WorkRemarks.FindAsync(EditingRemarkId);
        if (r is not null)
        {
            r.Content = EditingRemarkText.Trim();
            await db.SaveChangesAsync();
            // Refresh list
            RemarksList = await db.WorkRemarks
                .Where(x => x.WorkId == r.WorkId)
                .OrderBy(x => x.CreatedAt)
                .ToListAsync();
            if (RemarksList.Any())
                LatestRemarksMap[r.WorkId] = RemarksList.Last();
        }
        EditingRemarkId = 0; EditingRemarkText = "";
    }

    // ── Soft delete work ──────────────────────────────────────
    async Task SoftDeleteWork()
    {
        if (ConfirmDeleteWorkItem is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var w = await db.Works.FindAsync(ConfirmDeleteWorkItem.WorkId);
        if (w is not null)
        {
            w.IsDeleted = true;
            await db.SaveChangesAsync();
            await AuditSvc.LogAsync("works", w.WorkId, AuditAction.DELETE, CurrentEngineerId,
                new { w.WorkName });
        }
        ShowConfirmDeleteWork = false; ConfirmDeleteWorkItem = null;
        await LoadAll();
    }

