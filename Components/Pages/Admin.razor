    // ── Settings – Department management ─────────────────────
    void SaveNewDepartment()
    {
        NewDeptName = NewDeptName.Trim();
        if (string.IsNullOrWhiteSpace(NewDeptName)) { DeptError = "Name is required."; return; }
        if (DeptList.Any(d => d.Name.Equals(NewDeptName, StringComparison.OrdinalIgnoreCase)))
        { DeptError = "Already exists."; return; }
        DeptList = DeptList.Append(new DeptItem(NewDeptName)).OrderBy(d => d.Name).ToList();
        NewDeptName = ""; ShowInlineAddDept = false; DeptError = "";
    }

    // ── Password Change ───────────────────────────────────────
    void OpenPasswordModal()
    {
        PwdCurrent = PwdNew = PwdConfirm = PwdError = PwdSuccess = "";
        ShowPasswordModal = true;
    }
    void ClosePasswordModal() => ShowPasswordModal = false;

    async Task ChangePassword()
    {
        PwdError = PwdSuccess = "";
        if (string.IsNullOrWhiteSpace(PwdCurrent) || string.IsNullOrWhiteSpace(PwdNew))
        { PwdError = "All fields are required."; return; }
        if (PwdNew != PwdConfirm) { PwdError = "New passwords do not match."; return; }
        if (PwdNew.Length < 6)    { PwdError = "Password must be at least 6 characters."; return; }

        var auth  = await AuthState!;
        var idStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (idStr is null) { PwdError = "Session error. Please re-login."; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var eng = await db.Engineers.FindAsync(int.Parse(idStr));
        if (eng is null) { PwdError = "Account not found."; return; }
        if (!BCrypt.Net.BCrypt.Verify(PwdCurrent, eng.PasswordHash))
        { PwdError = "Current password is incorrect."; return; }

        eng.PasswordHash = BCrypt.Net.BCrypt.HashPassword(PwdNew);
        await db.SaveChangesAsync();
        PwdSuccess = "Password updated successfully.";
        PwdCurrent = PwdNew = PwdConfirm = "";
    }

    // ── Helpers ───────────────────────────────────────────────
    static string StatusBadge(WorkStatus s) => s switch
    {
        WorkStatus.ONGOING   => "bg-warning text-dark",
        WorkStatus.COMPLETED => "bg-success",
        WorkStatus.STALLED   => "bg-danger",
        WorkStatus.CANCELLED => "bg-secondary",
        _                    => "bg-light text-dark"
    };

    static string StatusLabel(WorkStatus s) => s switch
    {
        WorkStatus.ONGOING   => "Ongoing",
        WorkStatus.COMPLETED => "Completed",
        WorkStatus.STALLED   => "Stalled",
        WorkStatus.CANCELLED => "Cancelled",
        _                    => s.ToString()
    };

    static string RoleBadge(EngineerRole r) => r switch
    {
        EngineerRole.ADMIN => "bg-danger",
        EngineerRole.XEN   => "bg-dark",
        EngineerRole.AEN   => "bg-secondary",
        _                  => "bg-primary"
    };

    static string CatBadge(string? code) => (code ?? "").ToUpperInvariant() switch
    {
        "ROAD"      => "bg-primary",
        "DRAIN"     => "bg-info text-dark",
        "ELECTRIC"  => "bg-warning text-dark",
        "PARK"      => "bg-success",
        "TEMPLE"    => "bg-danger",
        "DEVISTHAN" => "bg-danger",
        "WATER"     => "bg-info text-dark",
        "BEAUTIFY"  => "bg-success",
        _           => "bg-secondary"
    };

    static string ProgColor(decimal pct) => pct switch
    {
        >= 75 => "progress-fill-green",
        >= 40 => "progress-fill-orange",
        _     => "progress-fill-red"
    };
