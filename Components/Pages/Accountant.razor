@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    string Section   = "works";
    bool   IsLoading = true;
    int?   CurrentEngineerId = null;
    string CurrentUserName   = "";

    // ── Data ─────────────────────────────────────────────────────
    List<Work>         AllWorks      = [];
    List<Work>         FilteredWorks = [];
    List<Engineer>     JenEngineers  = [];
    List<Engineer>     AenEngineers  = [];
    List<BudgetHead>   BudgetHeads   = [];
    Dictionary<int, WorkRemark> LatestRemarksMap = [];
    HashSet<int>       ExpandedWorkIds = [];

    // ── Works filters ─────────────────────────────────────────────
    string WorkTab        = "ONGOING";
    string WorkSearchText = "";
    string WorkJenFilter  = "";
    string WorkAenFilter  = "";
    string WorkYearFilter = "";

    List<string> WorkYears => AllWorks
        .Select(w => !string.IsNullOrEmpty(w.FinancialYear) ? w.FinancialYear
                     : (w.StartDate.HasValue ? FinYear(w.StartDate.Value) : null))
        .Where(y => !string.IsNullOrEmpty(y))
        .Distinct().OrderByDescending(y => y).ToList()!;

    static string FinYear(DateOnly d) => WorkHelpers.FinYear(d);

    // ── Detail modal ─────────────────────────────────────────────
    bool  ShowDetailModal = false;
    Work? DetailWork      = null;

    void OpenDetail(Work w) { DetailWork = w; ShowDetailModal = true; }
    void CloseDetail()      { ShowDetailModal = false; DetailWork = null; }

    // ── Work Edit modal ───────────────────────────────────────────
    bool   ShowWorkEditModal = false;
    Work   EditingWork       = new();
    string WorkEditStatusStr = "ONGOING";
    string WorkEditError     = "";
    string NewRemarkText     = "";
    string RemarkError       = "";
    List<WorkRemark> WorkEditRemarks = [];

    void OpenEditWork(Work w)
    {
        EditingWork = new Work
        {
            WorkId                  = w.WorkId,
            WorkName                = w.WorkName,
            WorkCode                = w.WorkCode,
            SanctionedAmount        = w.SanctionedAmount,
            AgreementAmount         = w.AgreementAmount,
            Expenditure             = w.Expenditure,
            ProgressPercent         = w.ProgressPercent,
            FinancialProgressPercent = w.FinancialProgressPercent,
            PaymentStatus           = w.PaymentStatus,
            Status                  = w.Status,
        };
        WorkEditStatusStr = w.Status.ToString();
        WorkEditError     = "";
        NewRemarkText     = "";
        RemarkError       = "";
        WorkEditRemarks   = [];

        // Load existing remarks from the latest-remarks map into list
        if (LatestRemarksMap.TryGetValue(w.WorkId, out var lr))
            WorkEditRemarks = [lr];

        ShowWorkEditModal = true;
        _ = LoadWorkRemarks(w.WorkId);
    }

    async Task LoadWorkRemarks(int workId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        WorkEditRemarks = await db.WorkRemarks
            .Where(r => r.WorkId == workId)
            .OrderBy(r => r.CreatedAt)
            .ToListAsync();
        StateHasChanged();
    }

    void CloseWorkEditModal()
    {
        ShowWorkEditModal = false;
        WorkEditRemarks   = [];
        NewRemarkText     = "";
    }

    async Task SaveWorkEdit()
    {
        WorkEditError = "";
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Works.FindAsync(EditingWork.WorkId);
        if (existing is null) { WorkEditError = "Work not found."; return; }

        existing.SanctionedAmount         = EditingWork.SanctionedAmount;
        existing.AgreementAmount          = EditingWork.AgreementAmount;
        existing.Expenditure              = EditingWork.Expenditure;
        existing.ProgressPercent          = EditingWork.ProgressPercent;
        existing.FinancialProgressPercent = EditingWork.FinancialProgressPercent;
        existing.PaymentStatus            = EditingWork.PaymentStatus;
        existing.Status                   = Enum.Parse<WorkStatus>(WorkEditStatusStr);
        existing.UpdatedAt                = DateTime.UtcNow;

        // Save optional remark
        if (!string.IsNullOrWhiteSpace(NewRemarkText))
        {
            db.WorkRemarks.Add(new WorkRemark
            {
                WorkId     = existing.WorkId,
                Content    = NewRemarkText.Trim(),
                AuthorName = CurrentUserName,
                AuthorId   = CurrentEngineerId,
                CreatedAt  = DateTime.UtcNow
            });
        }

        await db.SaveChangesAsync();
        await LoadAll();
        CloseWorkEditModal();
    }

    async Task AddWorkRemark()
    {
        RemarkError = "";
        if (string.IsNullOrWhiteSpace(NewRemarkText)) { RemarkError = "Remark cannot be empty."; return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        db.WorkRemarks.Add(new WorkRemark
        {
            WorkId     = EditingWork.WorkId,
            Content    = NewRemarkText.Trim(),
            AuthorName = CurrentUserName,
            AuthorId   = CurrentEngineerId,
            CreatedAt  = DateTime.UtcNow
        });
        await db.SaveChangesAsync();
        NewRemarkText = "";
        await LoadWorkRemarks(EditingWork.WorkId);
        LatestRemarksMap[EditingWork.WorkId] = WorkEditRemarks.Last();
    }

    // ── Budget Head settings ──────────────────────────────────────
    bool       ShowBudgetPanel    = true;
    bool       ShowBudgetModal    = false;
    BudgetHead EditingBudget      = new();
    string     BudgetError        = "";
    int        SelectedBudgetHeadId = 0;

    void OnBudgetHeadSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id) && id > 0)
        {
            var bh = BudgetHeads.FirstOrDefault(b => b.BudgetHeadId == id);
            if (bh != null) OpenEditBudget(bh);
        }
        SelectedBudgetHeadId = 0;
    }

    void OpenAddBudget()
    {
        EditingBudget = new BudgetHead();
        BudgetError = "";
        ShowBudgetModal = true;
    }

    void OpenEditBudget(BudgetHead bh)
    {
        EditingBudget = new BudgetHead
        {
            BudgetHeadId   = bh.BudgetHeadId,
            BudgetCode     = bh.BudgetCode,
            BudgetName     = bh.BudgetName,
            AvailableFund  = bh.AvailableFund,
            AmountSpent    = bh.AmountSpent,
            RemainingAmount = bh.RemainingAmount,
            IsActive       = bh.IsActive
        };
        BudgetError = "";
        ShowBudgetModal = true;
    }

    void CloseBudgetModal()
    {
        ShowBudgetModal = false;
        SelectedBudgetHeadId = 0;
    }

    void RecomputeRemaining()
    {
        EditingBudget.RemainingAmount = EditingBudget.AvailableFund - EditingBudget.AmountSpent;
    }

    async Task SaveBudget()
    {
        BudgetError = "";
        if (string.IsNullOrWhiteSpace(EditingBudget.BudgetCode))
        { BudgetError = "Budget Code is required."; return; }
        if (string.IsNullOrWhiteSpace(EditingBudget.BudgetName))
        { BudgetError = "Budget Name is required."; return; }

        EditingBudget.RemainingAmount = EditingBudget.AvailableFund - EditingBudget.AmountSpent;
        EditingBudget.UpdatedBy  = CurrentUserName;
        EditingBudget.UpdatedAt  = DateTime.UtcNow;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (EditingBudget.BudgetHeadId == 0)
        {
            EditingBudget.CreatedAt = DateTime.UtcNow;
            db.BudgetHeads.Add(EditingBudget);
        }
        else
        {
            var existing = await db.BudgetHeads.FindAsync(EditingBudget.BudgetHeadId);
            if (existing == null) { BudgetError = "Record not found."; return; }
            existing.BudgetCode      = EditingBudget.BudgetCode;
            existing.BudgetName      = EditingBudget.BudgetName;
            existing.AvailableFund   = EditingBudget.AvailableFund;
            existing.AmountSpent     = EditingBudget.AmountSpent;
            existing.RemainingAmount = EditingBudget.RemainingAmount;
            existing.UpdatedBy       = EditingBudget.UpdatedBy;
            existing.UpdatedAt       = EditingBudget.UpdatedAt;
        }

        try
        {
            await db.SaveChangesAsync();
            BudgetHeads = await db.BudgetHeads.OrderBy(b => b.BudgetCode).ToListAsync();
            CloseBudgetModal();
        }
        catch (Exception ex)
        {
            BudgetError = ex.InnerException?.Message.Contains("Duplicate") == true
                ? "Budget Code already exists."
                : "Save failed. Please try again.";
        }
    }

    // ── Password change ───────────────────────────────────────────
    bool   ShowPasswordModal = false;
    string PwdCurrent = "";
    string PwdNew     = "";
    string PwdConfirm = "";
    string PwdError   = "";
    string PwdSuccess = "";

    void OpenPasswordModal()  { PwdCurrent = PwdNew = PwdConfirm = PwdError = PwdSuccess = ""; ShowPasswordModal = true; }
    void ClosePasswordModal() { ShowPasswordModal = false; }

    async Task ChangePassword()
    {
        PwdError = PwdSuccess = "";
        if (string.IsNullOrWhiteSpace(PwdNew)) { PwdError = "New password cannot be empty."; return; }
        if (PwdNew != PwdConfirm)              { PwdError = "Passwords do not match."; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var eng = await db.Engineers.FindAsync(CurrentEngineerId);
        if (eng == null) { PwdError = "User not found."; return; }
        if (!BCrypt.Net.BCrypt.Verify(PwdCurrent, eng.PasswordHash)) { PwdError = "Current password is incorrect."; return; }

        eng.PasswordHash = BCrypt.Net.BCrypt.HashPassword(PwdNew);
        eng.UpdatedAt    = DateTime.UtcNow;
        await db.SaveChangesAsync();
        PwdSuccess = "Password updated successfully.";
    }

    string SectionTitle => Section switch
    {
        "works"    => "Works",
        "settings" => "Settings — Budget Master",
        _          => ""
    };

    protected override async Task OnInitializedAsync()
    {
        var auth  = await AuthState!;
        var idStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (idStr is not null && int.TryParse(idStr, out var id))
            CurrentEngineerId = id;
        CurrentUserName = auth.User.Identity?.Name ?? "";

        await LoadAll();
        IsLoading = false;
    }

    async Task LoadAll()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        AllWorks = await db.Works
            .Where(w => !w.IsDeleted)
            .Include(w => w.Category)
            .Include(w => w.FundSource)
            .Include(w => w.AssignedJen)
            .Include(w => w.AssignedAen)
            .Include(w => w.AssignedExen)
            .OrderByDescending(w => w.CreatedAt)
            .ToListAsync();

        var allEng    = await db.Engineers.Where(e => !e.IsDeleted).OrderBy(e => e.Name).ToListAsync();
        JenEngineers  = allEng.Where(e => e.Role == EngineerRole.JEN).ToList();
        AenEngineers  = allEng.Where(e => e.Role == EngineerRole.AEN).ToList();

        var allRemarks = await db.WorkRemarks.OrderBy(r => r.CreatedAt).ToListAsync();
        LatestRemarksMap = allRemarks
            .GroupBy(r => r.WorkId)
            .ToDictionary(g => g.Key, g => g.Last());

        BudgetHeads = await db.BudgetHeads.OrderBy(b => b.BudgetCode).ToListAsync();

        FilterWorks();
    }

    void SetWorkTab(string tab) { WorkTab = tab; FilterWorks(); }

    void ToggleExpand(int id)
    {
        if (!ExpandedWorkIds.Remove(id)) ExpandedWorkIds.Add(id);
    }

    void FilterWorks()
    {
        var q = AllWorks.AsEnumerable();

        q = WorkTab switch
        {
            "ONGOING"   => q.Where(w => w.Status == WorkStatus.ONGOING && !w.IsAnnualContract),
            "COMPLETED" => q.Where(w => w.Status == WorkStatus.COMPLETED),
            "ANNUAL"    => q.Where(w => w.IsAnnualContract),
            _           => q
        };

        if (!string.IsNullOrWhiteSpace(WorkSearchText))
        {
            var t = WorkSearchText.Trim();
            q = q.Where(w => w.WorkCode != null && w.WorkCode.Contains(t, StringComparison.OrdinalIgnoreCase)
                          || w.WorkName.Contains(t, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrEmpty(WorkJenFilter) && int.TryParse(WorkJenFilter, out var jenId))
            q = q.Where(w => w.AssignedJenId == jenId);
        if (!string.IsNullOrEmpty(WorkAenFilter) && int.TryParse(WorkAenFilter, out var aenId))
            q = q.Where(w => w.AssignedAenId == aenId);
        if (!string.IsNullOrEmpty(WorkYearFilter))
            q = q.Where(w =>
                (!string.IsNullOrEmpty(w.FinancialYear) && w.FinancialYear == WorkYearFilter) ||
                (string.IsNullOrEmpty(w.FinancialYear) && w.StartDate.HasValue && FinYear(w.StartDate!.Value) == WorkYearFilter));

        FilteredWorks = q.ToList();
    }

    void ResetWorkFilters()
    {
        WorkSearchText = WorkJenFilter = WorkAenFilter = WorkYearFilter = "";
        FilterWorks();
    }

}
