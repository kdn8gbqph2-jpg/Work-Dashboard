
@page "/accountant"
@attribute [Authorize(Roles = "ACCOUNTANT")]
@rendermode InteractiveServer
@inject IDbContextFactory<BdaDbContext> DbFactory
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore
@using Work_Dashboard.Data
@using Work_Dashboard.Data.Entities
@using System.Security.Claims

<PageTitle>Accountant — BDA Dashboard</PageTitle>

<div class="jen-shell">

    @* ── Sidebar ─────────────────────────────────────────────── *@
    <aside class="jen-sidebar">
        <div class="sidebar-brand">
            <img src="/images/bda-logo.png" alt="BDA" class="sidebar-logo" />
            <div>
                <div class="sidebar-title">BDA Accounts</div>
                <div class="sidebar-subtitle">Accountant Panel</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <button class="nav-item @(Section == "works"    ? "active" : "")" @onclick='() => Section = "works"'>
                <i class="bi bi-hammer"></i><span>Works</span>
            </button>
            <button class="nav-item @(Section == "settings" ? "active" : "")" @onclick='() => Section = "settings"'>
                <i class="bi bi-gear-fill"></i><span>Settings</span>
            </button>
        </nav>

        <div class="sidebar-footer">
            <button class="btn-logout w-100 mb-2" @onclick="OpenPasswordModal">
                <i class="bi bi-key-fill"></i> Change Password
            </button>
            <form method="post" action="/account/logout">
                <button type="submit" class="btn-logout w-100">
                    <i class="bi bi-box-arrow-left"></i> Logout
                </button>
            </form>
        </div>
    </aside>

    @* ── Main ───────────────────────────────────────────────── *@
    <main class="jen-main">

        <div class="jen-topbar">
            <div class="topbar-brand">
                <img src="/images/bda-logo.png" alt="BDA" class="topbar-logo" />
                <div>
                    <h5 class="mb-0 fw-bold">@SectionTitle</h5>
                    <small class="text-muted">Bharatpur Development Authority</small>
                </div>
            </div>
            <div class="topbar-user">
                <i class="bi bi-calculator-fill text-success me-1"></i>
                <AuthorizeView><span>@context.User.Identity?.Name</span></AuthorizeView>
            </div>
        </div>

        @if (IsLoading)
        {
            <div class="d-flex justify-content-center align-items-center" style="height:60vh">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {

        @* ══ WORKS ══════════════════════════════════════════════ *@
        if (Section == "works")
        {
            @* ── Work Tabs ── *@
            <div class="content-card p-0 mb-3">
                <div class="works-tab-bar">
                    <span class="works-tab-total">
                        <i class="bi bi-briefcase-fill me-1"></i>Total <strong>@AllWorks.Count</strong>
                    </span>
                    <button class="works-tab @(WorkTab == "ONGOING"   ? "active" : "")" @onclick='() => SetWorkTab("ONGOING")'>
                        <i class="bi bi-hourglass-split me-1"></i>Ongoing
                        <span class="works-tab-count">@AllWorks.Count(w => w.Status == WorkStatus.ONGOING && !w.IsAnnualContract)</span>
                    </button>
                    <button class="works-tab @(WorkTab == "COMPLETED" ? "active" : "")" @onclick='() => SetWorkTab("COMPLETED")'>
                        <i class="bi bi-check-circle-fill me-1"></i>Completed
                        <span class="works-tab-count">@AllWorks.Count(w => w.Status == WorkStatus.COMPLETED)</span>
                    </button>
                    <button class="works-tab @(WorkTab == "ANNUAL"    ? "active" : "")" @onclick='() => SetWorkTab("ANNUAL")'>
                        <i class="bi bi-arrow-repeat me-1"></i>Annual Works
                        <span class="works-tab-count">@AllWorks.Count(w => w.IsAnnualContract)</span>
                    </button>
                </div>
            </div>

            @* ── Filter Bar + Table ── *@
            <div class="content-card">
                <div class="works-filter-bar">
                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <div class="filter-search-wrap">
                            <i class="bi bi-search filter-search-icon"></i>
                            <input type="search" class="filter-search-input"
                                   placeholder="Search file no…"
                                   @bind="WorkSearchText" @bind:after="FilterWorks" />
                        </div>

                        <div class="filter-group">
                            <span class="filter-group-label">JEN</span>
                            <select class="filter-select-sm" @bind="WorkJenFilter" @bind:after="FilterWorks">
                                <option value="">All</option>
                                @foreach (var e in JenEngineers)
                                { <option value="@e.EngineerId">@e.Name</option> }
                            </select>
                        </div>

                        <div class="filter-group">
                            <span class="filter-group-label">AEN</span>
                            <select class="filter-select-sm" @bind="WorkAenFilter" @bind:after="FilterWorks">
                                <option value="">All</option>
                                @foreach (var e in AenEngineers)
                                { <option value="@e.EngineerId">@e.Name</option> }
                            </select>
                        </div>

                        <div class="filter-group">
                            <span class="filter-group-label"><i class="bi bi-calendar3 me-1"></i>Year</span>
                            <select class="filter-select-sm" @bind="WorkYearFilter" @bind:after="FilterWorks">
                                <option value="">All</option>
                                @foreach (var y in WorkYears)
                                { <option value="@y">@y</option> }
                            </select>
                        </div>

                        <button class="btn-filter-reset" @onclick="ResetWorkFilters">
                            <i class="bi bi-arrow-clockwise"></i> Reset
                        </button>

                        <span class="works-total-badge">
                            <i class="bi bi-briefcase-fill me-1"></i>@FilteredWorks.Count works
                        </span>

                        <div class="ms-auto d-flex align-items-center gap-2">
                            <div class="export-btn-group">
                                <button class="btn-export btn-export-csv"  title="Download CSV"   @onclick="ExportCsv">
                                    <i class="bi bi-filetype-csv"></i>
                                </button>
                                <button class="btn-export btn-export-xlsx" title="Download Excel"  @onclick="ExportExcel">
                                    <i class="bi bi-file-earmark-excel-fill"></i>
                                </button>
                                <button class="btn-export btn-export-pdf"  title="Download PDF"   @onclick="ExportPdf">
                                    <i class="bi bi-file-earmark-pdf-fill"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                @* ── Works Table ── *@
                <div class="table-responsive table-scroll-body">
                    <table class="table table-hover bda-table mb-0">
                        <thead class="thead-sticky">
                            <tr>
                                <th style="width:44px">#</th>
                                <th style="min-width:260px">Work Name / File No.</th>
                                <th style="min-width:110px">Status</th>
                                <th style="min-width:130px">Progress</th>
                                <th style="min-width:140px">Financial</th>
                                <th style="min-width:200px">Latest Remark</th>
                                <th class="text-center" style="min-width:100px">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredWorks.Any())
                            {
                                <tr><td colspan="7" class="text-center text-muted py-5">No records found.</td></tr>
                            }
                            @{ int wi = 1; }
                            @foreach (var w in FilteredWorks)
                            {
                                var lr = LatestRemarksMap.GetValueOrDefault(w.WorkId);
                                var remarkText = lr?.Content ?? (string.IsNullOrWhiteSpace(w.Remarks) ? null : w.Remarks);
                                bool isExpanded = ExpandedWorkIds.Contains(w.WorkId);
                                <tr class="@(isExpanded ? "work-row-expanded" : "")">
                                    <td class="text-muted fw-medium">@(wi++)</td>
                                    <td>
                                        <div class="d-flex align-items-start gap-1">
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="fw-semibold work-name-cell">@w.WorkName</div>
                                                <div class="d-flex align-items-center gap-1 mt-1">
                                                    @if (w.WorkCode != null)
                                                    { <span class="work-fileno"><i class="bi bi-folder2 me-1"></i>@w.WorkCode</span> }
                                                    @if (w.IsAnnualContract)
                                                    { <span class="badge badge-annual">Annual</span> }
                                                </div>
                                            </div>
                                            <button class="btn-expand-row" title="@(isExpanded ? "Collapse" : "Quick view")"
                                                    @onclick="() => ToggleExpand(w.WorkId)">
                                                <i class="bi bi-chevron-@(isExpanded ? "up" : "down")"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="status-pill status-pill-@w.Status.ToString().ToLower()">
                                            <span class="status-dot"></span>@StatusLabel(w.Status)
                                        </span>
                                    </td>
                                    <td>
                                        @if (w.ProgressPercent.HasValue)
                                        {
                                            <div class="mini-prog-wrap">
                                                <div style="font-size:0.68rem;color:#6b7280;margin-bottom:1px">Phys</div>
                                                <div class="mini-prog-bar">
                                                    <div class="mini-prog-fill @ProgColor(w.ProgressPercent.Value)"
                                                         style="width:@(w.ProgressPercent)%"></div>
                                                </div>
                                                <span class="mini-prog-label">@w.ProgressPercent%</span>
                                            </div>
                                        }
                                        @if (w.FinancialProgressPercent.HasValue)
                                        {
                                            <div class="mini-prog-wrap mt-1">
                                                <div style="font-size:0.68rem;color:#6b7280;margin-bottom:1px">Fin</div>
                                                <div class="mini-prog-bar">
                                                    <div class="mini-prog-fill mini-prog-fill-fin"
                                                         style="width:@(w.FinancialProgressPercent)%"></div>
                                                </div>
                                                <span class="mini-prog-label">@w.FinancialProgressPercent%</span>
                                            </div>
                                        }
                                        @if (!w.ProgressPercent.HasValue && !w.FinancialProgressPercent.HasValue)
                                        { <span class="text-muted">—</span> }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1" style="font-size:0.8rem">
                                            <span class="text-muted">Sanc: <strong class="text-dark">@(w.SanctionedAmount.HasValue ? $"₹{w.SanctionedAmount:N2}L" : "—")</strong></span>
                                            <span class="text-muted">WO: <strong class="text-dark">@(w.AgreementAmount.HasValue ? $"₹{w.AgreementAmount:N2}L" : "—")</strong></span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (remarkText != null)
                                        {
                                            <div class="remark-preview">@remarkText</div>
                                            <button class="btn-read-more" @onclick="() => OpenDetail(w)">Read more</button>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex gap-1 justify-content-center">
                                            <button class="action-btn action-btn-view" title="View Details"
                                                    @onclick="() => OpenDetail(w)">
                                                <i class="bi bi-eye-fill"></i>
                                            </button>
                                            <button class="action-btn action-btn-edit" title="Edit Financial / Remarks"
                                                    @onclick="() => OpenEditWork(w)">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                @if (isExpanded)
                                {
                                    <tr class="work-expand-row">
                                        <td colspan="7">
                                            <div class="work-expand-panel">
                                                <div class="expand-fullname">@w.WorkName</div>
                                                <div class="expand-grid">
                                                    <div class="expand-item">
                                                        <div class="expand-label">Physical Progress</div>
                                                        <div class="expand-val">
                                                            @if (w.ProgressPercent.HasValue)
                                                            {
                                                                <div class="progress-pill mb-1">
                                                                    <div class="progress-fill @ProgColor(w.ProgressPercent.Value)"
                                                                         style="width:@(w.ProgressPercent)%"></div>
                                                                </div>
                                                                <text>@w.ProgressPercent%</text>
                                                            }
                                                            else { <text>—</text> }
                                                        </div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Financial Progress</div>
                                                        <div class="expand-val">
                                                            @if (w.FinancialProgressPercent.HasValue)
                                                            {
                                                                <div class="progress-pill mb-1">
                                                                    <div class="progress-fill progress-fill-fin"
                                                                         style="width:@(w.FinancialProgressPercent)%"></div>
                                                                </div>
                                                                <text>@w.FinancialProgressPercent%</text>
                                                            }
                                                            else { <text>—</text> }
                                                        </div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Sanctioned Amount</div>
                                                        <div class="expand-val">@(w.SanctionedAmount.HasValue ? $"₹ {w.SanctionedAmount:N2} L" : "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Workorder Amount</div>
                                                        <div class="expand-val">@(w.AgreementAmount.HasValue ? $"₹ {w.AgreementAmount:N2} L" : "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Contractor</div>
                                                        <div class="expand-val">@(w.ContractorName ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Stipulated Start</div>
                                                        <div class="expand-val">@(w.StartDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Stipulated Completion</div>
                                                        <div class="expand-val">@(w.ExpectedCompletion?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Actual Start</div>
                                                        <div class="expand-val">@(w.ActualStartDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Actual Completion</div>
                                                        <div class="expand-val">@(w.ActualCompletion?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Financial Year</div>
                                                        <div class="expand-val">@(w.FinancialYear ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Category</div>
                                                        <div class="expand-val">@(w.Category?.CategoryName ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Fund Source</div>
                                                        <div class="expand-val">@(w.FundSource?.SourceName ?? "—")</div>
                                                    </div>
                                                    <div class="expand-item">
                                                        <div class="expand-label">Flags</div>
                                                        <div class="expand-val">
                                                            @if (w.IsCmBudget)       { <span class="badge bg-warning text-dark me-1" style="font-size:0.65rem">CM Budget</span> }
                                                            @if (w.IsScheme)         { <span class="badge bg-success me-1" style="font-size:0.65rem">Scheme</span> }
                                                            @if (w.IsAnnualContract) { <span class="badge bg-info text-dark me-1" style="font-size:0.65rem">Annual</span> }
                                                            @if (!w.IsCmBudget && !w.IsScheme && !w.IsAnnualContract) { <text>—</text> }
                                                        </div>
                                                    </div>
                                                </div>
                                                @if (lr != null)
                                                {
                                                    <div class="expand-remark">
                                                        <i class="bi bi-chat-left-text me-1 text-primary"></i>
                                                        <span class="text-muted" style="font-size:0.72rem">
                                                            @lr.AuthorName · @lr.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                                        </span>
                                                        <div class="expand-remark-text">@lr.Content</div>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ══ SETTINGS ════════════════════════════════════════════ *@
        if (Section == "settings")
        {
            <div class="row g-3 align-items-start">

                @* ── Budget Head Master panel ── *@
                <div class="col-12">
                    <div class="settings-panel-card">
                        <button class="settings-panel-trigger" @onclick="() => ShowBudgetPanel = !ShowBudgetPanel">
                            <i class="bi bi-wallet2 text-success"></i>
                            <span class="fw-semibold">Budget Head Master</span>
                            <span class="badge bg-secondary ms-1">@BudgetHeads.Count</span>
                            <i class="bi bi-chevron-@(ShowBudgetPanel ? "up" : "down") ms-auto"></i>
                        </button>

                        @if (ShowBudgetPanel)
                        {
                            <div class="settings-panel-body">

                                @* ── Select existing or Add New ── *@
                                <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                                    <div class="filter-group" style="min-width:260px">
                                        <span class="filter-group-label"><i class="bi bi-wallet2 me-1"></i>Budget Head</span>
                                        <select class="filter-select-sm" value="@SelectedBudgetHeadId"
                                                @onchange="OnBudgetHeadSelected">
                                            <option value="0">— Select to edit —</option>
                                            @foreach (var bh in BudgetHeads)
                                            { <option value="@bh.BudgetHeadId">@bh.BudgetCode — @bh.BudgetName</option> }
                                        </select>
                                    </div>
                                    <button class="btn btn-sm btn-success px-3" @onclick="OpenAddBudget">
                                        <i class="bi bi-plus-lg me-1"></i>Add New Budget Head
                                    </button>
                                </div>

                                @* ── Budget Heads table ── *@
                                <div class="table-responsive">
                                    <table class="table table-sm bda-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>Code</th>
                                                <th>Budget Name</th>
                                                <th class="text-end">Available Fund (₹ L)</th>
                                                <th class="text-end">Amount Spent (₹ L)</th>
                                                <th class="text-end">Remaining (₹ L)</th>
                                                <th>Updated By</th>
                                                <th>Updated At</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!BudgetHeads.Any())
                                            {
                                                <tr><td colspan="8" class="text-center text-muted py-3">No budget heads added yet.</td></tr>
                                            }
                                            @foreach (var bh in BudgetHeads)
                                            {
                                                <tr>
                                                    <td><span class="work-fileno">@bh.BudgetCode</span></td>
                                                    <td class="fw-medium">@bh.BudgetName</td>
                                                    <td class="text-end">@bh.AvailableFund.ToString("N2")</td>
                                                    <td class="text-end">@bh.AmountSpent.ToString("N2")</td>
                                                    <td class="text-end @(bh.RemainingAmount < 0 ? "text-danger fw-bold" : "text-success fw-bold")">
                                                        @bh.RemainingAmount.ToString("N2")
                                                    </td>
                                                    <td class="text-muted" style="font-size:0.82rem">@(bh.UpdatedBy ?? "—")</td>
                                                    <td class="text-muted" style="font-size:0.82rem">
                                                        @(bh.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                                                    </td>
                                                    <td class="text-center">
                                                        <button class="action-btn action-btn-edit" title="Edit"
                                                                @onclick="() => OpenEditBudget(bh)">
                                                            <i class="bi bi-pencil-fill"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        @if (BudgetHeads.Any())
                                        {
                                            <tfoot class="table-light fw-bold">
                                                <tr>
                                                    <td colspan="2">Total</td>
                                                    <td class="text-end">@BudgetHeads.Sum(b => b.AvailableFund).ToString("N2")</td>
                                                    <td class="text-end">@BudgetHeads.Sum(b => b.AmountSpent).ToString("N2")</td>
                                                    <td class="text-end @(BudgetHeads.Sum(b => b.RemainingAmount) < 0 ? "text-danger" : "text-success")">
                                                        @BudgetHeads.Sum(b => b.RemainingAmount).ToString("N2")
                                                    </td>
                                                    <td colspan="3"></td>
                                                </tr>
                                            </tfoot>
                                        }
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>
        }

        } @* end else IsLoading *@
    </main>
</div>

@* ══ WORK DETAIL MODAL ══════════════════════════════════════════ *@
@if (ShowDetailModal && DetailWork != null)
{
    <div class="modal-overlay" @onclick="CloseDetail">
        <div class="modal-box modal-box-lg" style="max-width:680px" @onclick:stopPropagation>
            <div class="modal-box-header">
                <div>
                    <h6 class="mb-0 fw-bold">Work Details</h6>
                    @if (DetailWork.WorkCode != null)
                    { <small class="text-muted">📁 @DetailWork.WorkCode</small> }
                </div>
                <button class="btn-close" @onclick="CloseDetail"></button>
            </div>
            <div class="modal-box-body">

                <p class="detail-section-title">Basic Information</p>
                <div class="detail-grid">
                    <div><div class="detail-label">Work Name</div><div class="detail-val">@DetailWork.WorkName</div></div>
                    <div><div class="detail-label">File No.</div><div class="detail-val">@(DetailWork.WorkCode ?? "—")</div></div>
                    <div>
                        <div class="detail-label">Category</div>
                        <div class="detail-val">@(DetailWork.Category?.CategoryName ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Status</div>
                        <div class="detail-val">
                            <span class="status-pill status-pill-@DetailWork.Status.ToString().ToLower()">
                                <span class="status-dot"></span>@StatusLabel(DetailWork.Status)
                            </span>
                        </div>
                    </div>
                    <div><div class="detail-label">Department</div><div class="detail-val">@(DetailWork.Department ?? "—")</div></div>
                    <div><div class="detail-label">Fund Source</div><div class="detail-val">@(DetailWork.FundSource?.SourceName ?? "—")</div></div>
                    <div>
                        <div class="detail-label">Flags</div>
                        <div class="detail-val">
                            @if (DetailWork.IsScheme)         { <span class="badge bg-primary me-1" style="font-size:0.65rem">Scheme</span> }
                            @if (DetailWork.IsCmBudget)       { <span class="badge bg-success me-1" style="font-size:0.65rem">CM Budget</span> }
                            @if (DetailWork.IsAnnualContract) { <span class="badge bg-info text-dark me-1" style="font-size:0.65rem">Annual</span> }
                            @if (!DetailWork.IsScheme && !DetailWork.IsCmBudget && !DetailWork.IsAnnualContract) { <text>—</text> }
                        </div>
                    </div>
                </div>

                <p class="detail-section-title">Engineers</p>
                <div class="detail-grid">
                    <div><div class="detail-label">JEN</div><div class="detail-val">@(DetailWork.AssignedJen?.Name ?? "—")</div></div>
                    <div><div class="detail-label">AEN</div><div class="detail-val">@(DetailWork.AssignedAen?.Name ?? "—")</div></div>
                    <div><div class="detail-label">XEN</div><div class="detail-val">@(DetailWork.AssignedExen?.Name ?? "—")</div></div>
                </div>

                <p class="detail-section-title">Financial</p>
                <div class="detail-grid">
                    <div><div class="detail-label">Sanctioned Amount (L)</div><div class="detail-val">@(DetailWork.SanctionedAmount?.ToString("N2") ?? "—")</div></div>
                    <div><div class="detail-label">Workorder Amount (L)</div><div class="detail-val">@(DetailWork.AgreementAmount?.ToString("N2") ?? "—")</div></div>
                    <div><div class="detail-label">Expenditure (L)</div><div class="detail-val">@(DetailWork.Expenditure?.ToString("N2") ?? "—")</div></div>
                </div>

                <p class="detail-section-title">Progress &amp; Dates</p>
                <div class="detail-grid">
                    <div><div class="detail-label">Stipulated Work Start Date</div><div class="detail-val">@(DetailWork.StartDate?.ToString("dd/MM/yyyy") ?? "—")</div></div>
                    <div><div class="detail-label">Stipulated Work Completion Date</div><div class="detail-val">@(DetailWork.ExpectedCompletion?.ToString("dd/MM/yyyy") ?? "—")</div></div>
                    <div><div class="detail-label">Actual Work Start Date</div><div class="detail-val">@(DetailWork.ActualStartDate?.ToString("dd/MM/yyyy") ?? "—")</div></div>
                    <div><div class="detail-label">Actual Work Completion Date</div><div class="detail-val">@(DetailWork.ActualCompletion?.ToString("dd/MM/yyyy") ?? "—")</div></div>
                    <div><div class="detail-label">Financial Year</div><div class="detail-val">@(DetailWork.FinancialYear ?? "—")</div></div>
                    <div>
                        <div class="detail-label">Physical Progress</div>
                        <div class="detail-val">
                            @if (DetailWork.ProgressPercent.HasValue)
                            {
                                <div class="progress-pill mb-1">
                                    <div class="progress-fill @ProgColor(DetailWork.ProgressPercent.Value)"
                                         style="width:@(DetailWork.ProgressPercent)%"></div>
                                </div>
                                @($"{DetailWork.ProgressPercent}%")
                            }
                            else { <text>—</text> }
                        </div>
                    </div>
                    <div>
                        <div class="detail-label">Financial Progress</div>
                        <div class="detail-val">
                            @if (DetailWork.FinancialProgressPercent.HasValue)
                            {
                                <div class="progress-pill mb-1">
                                    <div class="progress-fill progress-fill-fin"
                                         style="width:@(DetailWork.FinancialProgressPercent)%"></div>
                                </div>
                                @($"{DetailWork.FinancialProgressPercent}%")
                            }
                            else { <text>—</text> }
                        </div>
                    </div>
                </div>

                <p class="detail-section-title">Contractor</p>
                <div class="detail-grid">
                    <div><div class="detail-label">Contractor Name</div><div class="detail-val">@(DetailWork.ContractorName ?? "—")</div></div>
                    <div><div class="detail-label">Mobile</div><div class="detail-val">@(DetailWork.ContractorMobile ?? "—")</div></div>
                    <div><div class="detail-label">Location</div><div class="detail-val">@(DetailWork.Location ?? "—")</div></div>
                    <div><div class="detail-label">Ward No.</div><div class="detail-val">@(DetailWork.WardNumber ?? "—")</div></div>
                </div>

                @{
                    var detailLr = LatestRemarksMap.GetValueOrDefault(DetailWork.WorkId);
                }
                @if (detailLr != null)
                {
                    <p class="detail-section-title">Latest Remark</p>
                    <div class="expand-remark">
                        <i class="bi bi-chat-left-text me-1 text-primary"></i>
                        <span class="text-muted" style="font-size:0.72rem">
                            @detailLr.AuthorName · @detailLr.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </span>
                        <div class="expand-remark-text">@detailLr.Content</div>
                    </div>
                }

            </div>
        </div>
    </div>
}

@* ══ WORK EDIT MODAL (Accountant) ══════════════════════════════ *@
@if (ShowWorkEditModal && EditingWork != null)
{
    <div class="modal-overlay" @onclick="CloseWorkEditModal">
        <div class="modal-box modal-box-lg" style="max-width:720px" @onclick:stopPropagation>
            <div class="modal-box-header">
                <div>
                    <h6 class="mb-0 fw-bold">Edit Work</h6>
                    <small class="text-muted">@EditingWork.WorkName</small>
                </div>
                <button class="btn-close" @onclick="CloseWorkEditModal"></button>
            </div>
            <div class="modal-box-body">
                @if (!string.IsNullOrEmpty(WorkEditError))
                {
                    <div class="alert alert-danger py-2">@WorkEditError</div>
                }

                @* ── Financial fields ── *@
                <p class="detail-section-title">Financial</p>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Sanctioned Amt (₹ Lakhs)</label>
                        <input type="number" step="0.01" min="0" class="form-control"
                               @bind="EditingWork.SanctionedAmount" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Workorder Amt (₹ Lakhs)</label>
                        <input type="number" step="0.01" min="0" class="form-control"
                               @bind="EditingWork.AgreementAmount" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Expenditure (₹ Lakhs)</label>
                        <input type="number" step="0.01" min="0" class="form-control"
                               @bind="EditingWork.Expenditure" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Physical Progress (%)</label>
                        <input type="number" step="1" min="0" max="100" class="form-control"
                               @bind="EditingWork.ProgressPercent" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Financial Progress (%)</label>
                        <input type="number" step="1" min="0" max="100" class="form-control"
                               @bind="EditingWork.FinancialProgressPercent" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Status</label>
                        <select class="form-select" @bind="WorkEditStatusStr">
                            <option value="ONGOING">Ongoing</option>
                            <option value="COMPLETED">Completed</option>
                            <option value="STALLED">Stalled</option>
                            <option value="CANCELLED">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Payment Status</label>
                        <input type="text" class="form-control" placeholder="e.g. Paid, Pending, Partial…"
                               @bind="EditingWork.PaymentStatus" />
                    </div>
                </div>

                @* ── Remarks ── *@
                <p class="detail-section-title">Add Remark</p>

                @* Existing remarks list *@
                @if (WorkEditRemarks.Any())
                {
                    <div class="mb-3" style="max-height:160px;overflow-y:auto">
                        @foreach (var r in WorkEditRemarks)
                        {
                            <div class="expand-remark mb-2">
                                <span class="text-muted" style="font-size:0.72rem">
                                    @r.AuthorName · @r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                </span>
                                <div class="expand-remark-text">@r.Content</div>
                            </div>
                        }
                    </div>
                }

                <div class="mb-3">
                    <textarea class="form-control" rows="3" placeholder="Add a new remark…"
                              @bind="NewRemarkText"></textarea>
                    @if (!string.IsNullOrEmpty(RemarkError))
                    { <div class="text-danger mt-1" style="font-size:0.82rem">@RemarkError</div> }
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-secondary btn-sm px-3" @onclick="CloseWorkEditModal">Cancel</button>
                    <button class="btn btn-outline-primary btn-sm px-3" @onclick="AddWorkRemark">
                        <i class="bi bi-chat-left-text me-1"></i>Add Remark Only
                    </button>
                    <button class="btn btn-success btn-sm px-3" @onclick="SaveWorkEdit">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                </div>

                @* ── Running Bills ── *@
                <hr class="my-3" />
                <Work_Dashboard.Components.Shared.WorkBillsPanel
                    WorkId="@EditingWork.WorkId"
                    AgreementAmount="@EditingWork.AgreementAmount"
                    SanctionedAmount="@EditingWork.SanctionedAmount"
                    CanEdit="true"
                    CurrentUserId="@CurrentEngineerId"
                    CurrentUserName="@CurrentUserName" />

            </div>
        </div>
    </div>
}

@* ══ BUDGET HEAD MODAL ══════════════════════════════════════════ *@
@if (ShowBudgetModal)
{
    <div class="modal-overlay" @onclick="CloseBudgetModal">
